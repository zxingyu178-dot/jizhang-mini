.bf {
  padding: 0 28rpx 28rpx;
  display: flex;
  flex-direction: column;
}

/* 收支切换 */
.bf-seg {
  display: flex;
  background: rgba(255, 255, 255, 0.06);
  border-radius: 16rpx;
  padding: 6rpx;
  margin-bottom: 24rpx;
}
.bf-seg__item {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: var(--text-secondary);
  padding: 16rpx 0;
  border-radius: 12rpx;
  transition: all 0.2s ease;
}
.bf-seg__item--exp {
  background: rgba(61, 220, 143, 0.16);
  color: #3ddc8f;
  font-weight: 600;
}
.bf-seg__item--inc {
  background: rgba(255, 107, 107, 0.16);
  color: #ff6b6b;
  font-weight: 600;
}

/* 金额 */
.bf-amount {
  display: flex;
  align-items: center;
  padding: 12rpx 0 28rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
  margin-bottom: 24rpx;
}
.bf-amount__sym {
  font-size: 44rpx;
  color: var(--text-secondary);
  margin-right: 12rpx;
}
.bf-amount__input {
  flex: 1;
  font-size: 72rpx;
  font-weight: 700;
  color: var(--text-primary);
  min-width: 0;
}
.bf-amount__ph {
  color: rgba(255, 255, 255, 0.22);
  font-weight: 700;
}

/* 分类横向滚动 */
.bf-cats {
  margin-bottom: 20rpx;
}
.bf-cats__inner {
  display: flex;
  padding: 4rpx 0;
}
.bf-cat {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 120rpx;
  padding: 16rpx 0;
  margin-right: 12rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid transparent;
  transition: all 0.18s ease;
}
.bf-cat--active {
  background: rgba(124, 134, 255, 0.18);
  border-color: rgba(124, 134, 255, 0.55);
}
.bf-cat__emoji {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}
.bf-cat__name {
  font-size: 22rpx;
  color: var(--text-secondary);
}
.bf-cat--active .bf-cat__name {
  color: var(--text-primary);
}

/* 表单行 */
.bf-row {
  display: flex;
  align-items: center;
  padding: 24rpx 8rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}
.bf-row__label {
  width: 120rpx;
  font-size: 28rpx;
  color: var(--text-secondary);
}
.bf-row__value {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-primary);
}
.bf-row__input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-primary);
  min-width: 0;
}
.bf-row__ph {
  color: rgba(255, 255, 255, 0.25);
}

/* 计算日价开关 */
.bf-daily {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding: 20rpx 20rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.04);
}
.bf-daily__text {
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.bf-daily__label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}
.bf-daily__sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--text-faint);
}
.bf-switch {
  position: relative;
  flex-shrink: 0;
  width: 84rpx;
  height: 48rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  transition: background 0.2s ease;
}
.bf-switch--on {
  background: linear-gradient(135deg, #7c86ff 0%, #5b67f0 100%);
}
.bf-switch__knob {
  position: absolute;
  top: 5rpx;
  left: 5rpx;
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  background: #ffffff;
  transition: transform 0.2s ease;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.3);
}
.bf-switch--on .bf-switch__knob {
  transform: translateX(36rpx);
}

/* 删除按钮 */
.bf-delete {
  margin-top: 20rpx;
  padding: 22rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: #ff6b6b;
  border-radius: 16rpx;
  background: rgba(255, 107, 107, 0.1);
}

/* 确认按钮 */
.bf-submit {
  margin-top: 28rpx;
  padding: 28rpx 0;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #7c86ff 0%, #5b67f0 100%);
  box-shadow: 0 10rpx 28rpx rgba(91, 103, 240, 0.4);
}
.bf-submit--disabled {
  opacity: 0.45;
  box-shadow: none;
}
