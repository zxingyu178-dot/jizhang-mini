.bf {
  padding: 0 28rpx 28rpx;
  display: flex;
  flex-direction: column;
}

/* 收支切换（轻玻璃分段，选中仅轻 tint） */
.bf-seg {
  display: flex;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 14rpx;
  padding: 4rpx;
  margin-bottom: 20rpx;
}
.bf-seg__item {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: var(--text-secondary);
  padding: 14rpx 0;
  border-radius: 10rpx;
  transition: all 0.2s ease;
}
.bf-seg__item--exp {
  background: rgba(61, 220, 143, 0.12);
  color: #46d998;
  font-weight: 600;
}
.bf-seg__item--inc {
  background: rgba(255, 107, 107, 0.12);
  color: #ff7a7a;
  font-weight: 600;
}

/* 金额（明确高度 / 行高，避免机型原生 input baseline 差异导致下半部裁切） */
.bf-amount {
  display: flex;
  align-items: center;
  height: 132rpx;
  box-sizing: border-box;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
  margin-bottom: 24rpx;
}
.bf-amount__sym {
  font-size: 44rpx;
  color: var(--text-secondary);
  margin-right: 12rpx;
  line-height: 100rpx;
}
.bf-amount__input {
  flex: 1;
  height: 100rpx;
  line-height: 100rpx;
  font-size: 68rpx;
  font-weight: 700;
  color: var(--text-primary);
  min-width: 0;
}
.bf-amount__ph {
  color: rgba(255, 255, 255, 0.22);
  font-weight: 700;
}

/* 分类：最近使用 + 更多（换行网格，不横向滚动） */
.bf-cats-label {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin: 12rpx 0 10rpx;
}
.bf-cats-grid {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 12rpx;
}
.bf-cat {
  width: 25%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 14rpx 0;
  border-radius: 16rpx;
  overflow: hidden;
  transition: all 0.18s ease;
}
.bf-cat--active {
  background: rgba(124, 134, 255, 0.16);
}
.bf-cat__emoji {
  font-size: 40rpx;
  margin-bottom: 6rpx;
}
.bf-cat__more-icon {
  margin-bottom: 6rpx;
}
.bf-cat__name {
  font-size: 22rpx;
  color: var(--text-secondary);
  max-width: 100%;
  padding: 0 6rpx;
  box-sizing: border-box;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.bf-cat--active .bf-cat__name {
  color: var(--text-primary);
}

/* 表单行 */
.bf-row {
  display: flex;
  align-items: center;
  padding: 24rpx 8rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}
.bf-row__label {
  width: 120rpx;
  font-size: 28rpx;
  color: var(--text-secondary);
}
.bf-row__value {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-primary);
}
.bf-row__input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-primary);
  min-width: 0;
}
.bf-row__ph {
  color: rgba(255, 255, 255, 0.25);
}

/* 计算日价开关 */
.bf-daily {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding: 20rpx 20rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.04);
}
.bf-daily__text {
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.bf-daily__label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}
.bf-daily__sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--text-faint);
}
.bf-switch {
  position: relative;
  flex-shrink: 0;
  width: 84rpx;
  height: 48rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  transition: background 0.2s ease;
}
.bf-switch--on {
  background: var(--button-primary);
}
.bf-switch__knob {
  position: absolute;
  top: 5rpx;
  left: 5rpx;
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  background: #ffffff;
  transition: transform 0.2s ease;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.3);
}
.bf-switch--on .bf-switch__knob {
  transform: translateX(36rpx);
}

/* 删除按钮 */
.bf-delete {
  margin-top: 20rpx;
  padding: 22rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: #ff6b6b;
  border-radius: 16rpx;
  background: rgba(255, 107, 107, 0.1);
}

/* 确认按钮（减重：半透明紫、轻高光、固定高度） */
.bf-submit {
  margin-top: 24rpx;
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--button-primary-text);
  border-radius: 18rpx;
  background: var(--button-primary);
  border: none;
  box-shadow: var(--button-primary-shadow);
}
.bf-submit--disabled {
  background: var(--button-disabled);
  color: var(--button-disabled-text);
  border: none;
  box-shadow: none;
}
