.bf {
  padding: 0 28rpx 28rpx;
  display: flex;
  flex-direction: column;
}

/* 收支切换（轻玻璃分段，选中仅轻 tint） */
.bf-seg {
  display: flex;
  background: var(--surface);
  border: 1rpx solid var(--divider);
  border-radius: 14rpx;
  padding: 4rpx;
  margin-bottom: 20rpx;
}
.bf-seg__item {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: var(--text-secondary);
  padding: 14rpx 0;
  border-radius: 10rpx;
  transition: all 0.2s ease;
}
.bf-seg__item--exp {
  background: var(--expense-soft);
  color: var(--expense);
  font-weight: 600;
}
.bf-seg__item--inc {
  background: var(--income-soft);
  color: var(--income);
  font-weight: 600;
}

/* 金额（明确高度 / 行高，避免机型原生 input baseline 差异导致下半部裁切） */
.bf-amount {
  display: flex;
  align-items: center;
  height: 132rpx;
  box-sizing: border-box;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid var(--divider);
  margin-bottom: 24rpx;
}
.bf-amount__sym {
  font-size: 44rpx;
  color: var(--text-secondary);
  margin-right: 12rpx;
  line-height: 100rpx;
}
.bf-amount__input {
  flex: 1;
  height: var(--input-h-amount);
  line-height: var(--input-h-amount);
  padding: 0;
  box-sizing: border-box;
  font-size: 68rpx;
  font-weight: 700;
  color: var(--text-primary);
  min-width: 0;
}
.bf-amount__ph {
  color: var(--text-faint);
  font-weight: 700;
}
/* 数字键盘完成：轻玻璃胶囊，88rpx 高度（约 44px 触控），不挤压金额。 */
.bf-amount__done {
  flex-shrink: 0;
  min-width: 96rpx;
  height: 88rpx;
  line-height: 88rpx;
  margin-left: 16rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  text-align: center;
  font-size: 24rpx;
  color: var(--text-secondary);
  background: var(--glass-input);
  border: 1rpx solid var(--glass-input-border);
  border-radius: 14rpx;
}
.bf-amount__done--hover {
  background: var(--selected-bg);
  color: var(--text-primary);
}

/* 分类：最近使用 + 更多（换行网格，不横向滚动） */
.bf-cats-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 12rpx 0 10rpx;
}
.bf-cats-label {
  font-size: 26rpx;
  color: var(--text-secondary);
}
/* 展开态才有「收起」：展开后分类从 5 个变 12 个、保存按钮被推出首屏，必须留回退入口 */
.bf-cats-collapse {
  font-size: 24rpx;
  color: var(--primary-text);
  padding: 4rpx 12rpx;
}
.bf-cats-grid {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 8rpx;
}
/* 分类格：padding / 图标间距 / 字号都按「展开 12 个时仍尽量留住保存按钮」定，
   每格从 58.7px 压到约 53px（实测值），3 行省出约 18px 纵向空间。 */
.bf-cat {
  width: 25%;
  min-width: 0;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 0;
  border-radius: 16rpx;
  overflow: hidden;
  transition: all 0.18s ease;
}
.bf-cat--active {
  background: var(--primary-tint);
}
.bf-cat__icon {
  margin-bottom: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.bf-cat__more-icon {
  margin-bottom: 4rpx;
}
.bf-cat__name {
  font-size: 21rpx;
  color: var(--text-secondary);
  max-width: 100%;
  padding: 0 6rpx;
  box-sizing: border-box;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.bf-cat--active .bf-cat__name {
  color: var(--text-primary);
}

/* 表单行：上下内边距 22rpx（原 24rpx）。行高仍 40px 以上、触控达标，
   挤出的是「展开 12 个分类时保存按钮仍完整可见」的纵向预算。 */
.bf-row {
  display: flex;
  align-items: center;
  padding: 22rpx 8rpx;
  border-bottom: 1rpx solid var(--divider);
}
.bf-row__label {
  width: 120rpx;
  flex-shrink: 0;
  font-size: 28rpx;
  color: var(--text-secondary);
}
/* 日期行：label + 快捷钮 + 日期 picker 同一行，不额外占高度 */
.bf-row--date {
  gap: 10rpx;
}
/* 「昨天 / 前天」快捷钮：仅日期为今天时出现（补记昨天的账一步到位）。
   胶囊高度控制在 40rpx 以内，不能把 24rpx 行内边距撑大。 */
.bf-quick {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}
.bf-chip {
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 28rpx;
  color: var(--text-secondary);
  background: var(--glass-input);
  border: 1rpx solid var(--glass-input-border);
}
.bf-chip + .bf-chip {
  margin-left: 8rpx;
}
.bf-chip--hover {
  background: var(--selected-bg);
  color: var(--text-primary);
}
.bf-date {
  flex: 1;
  min-width: 0;
}
.bf-row__value {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: var(--text-primary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
/* picker 内部那层 view：撑满 picker 并右对齐，保持「日期 ›」贴右边 */
.bf-row__value--date {
  flex: none;
  width: 100%;
  text-align: right;
}
/* 普通输入（商户 / 备注）：统一高度与行高，垂直居中，不随系统原生 baseline 漂移。 */
.bf-row__input {
  flex: 1;
  min-width: 0;
  height: var(--input-h-normal);
  line-height: var(--input-h-normal);
  padding: 0;
  box-sizing: border-box;
  font-size: 28rpx;
  color: var(--text-primary);
}
.bf-row__ph {
  color: var(--text-faint);
}

/* 计算日价：低频附加项压成单行（原两行卡片 66px → 单行约 42px），
   把纵向预算留给分类与保存按钮 —— 实测表单内容已顶到弹层可视高度临界值。 */
.bf-daily {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  padding: 0 20rpx;
  height: 72rpx;
  box-sizing: border-box;
  border-radius: 18rpx;
  background: var(--surface-soft);
}
.bf-daily__label {
  flex-shrink: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}
.bf-daily__sub {
  flex: 1;
  min-width: 0;
  margin-left: 12rpx;
  font-size: 22rpx;
  color: var(--text-faint);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.bf-switch {
  position: relative;
  flex-shrink: 0;
  width: 84rpx;
  height: 48rpx;
  border-radius: 999rpx;
  background: var(--switch-off-bg);
  transition: background 0.2s ease;
}
.bf-switch--on {
  background: var(--button-primary);
}
.bf-switch__knob {
  position: absolute;
  top: 5rpx;
  left: 5rpx;
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  background: #ffffff;
  transition: transform 0.2s ease;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.3);
}
.bf-switch--on .bf-switch__knob {
  transform: translateX(36rpx);
}

/* 删除按钮 */
.bf-delete {
  margin-top: 20rpx;
  padding: 22rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: var(--danger);
  border-radius: 16rpx;
  background: var(--danger-soft);
}

/* 确认按钮（减重：半透明紫、轻高光、固定高度） */
.bf-submit {
  margin-top: 20rpx;
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--button-primary-text);
  border-radius: 18rpx;
  background: var(--button-primary);
  border: none;
  box-shadow: var(--button-primary-shadow);
}
.bf-submit--disabled {
  background: var(--button-disabled);
  color: var(--button-disabled-text);
  border: none;
  box-shadow: none;
}
