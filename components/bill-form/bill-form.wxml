<view class="bf">
  <!-- 收支类型切换 -->
  <view class="bf-seg">
    <view class="bf-seg__item {{type === 'expense' ? 'bf-seg__item--exp' : ''}}" data-type="expense" bindtap="onType">支出</view>
    <view class="bf-seg__item {{type === 'income' ? 'bf-seg__item--inc' : ''}}" data-type="income" bindtap="onType">收入</view>
  </view>

  <!-- 金额 -->
  <view class="bf-amount">
    <text class="bf-amount__sym">¥</text>
    <input
      class="bf-amount__input"
      type="digit"
      placeholder="0.00"
      placeholder-class="bf-amount__ph"
      value="{{amountText}}"
      bindinput="onAmount"
      bindfocus="onAmountFocus"
      bindblur="onAmountBlur"
      adjust-position="{{false}}"
      focus="{{amountFocused}}"
    />
    <view
      class="bf-amount__done"
      hover-class="bf-amount__done--hover"
      hover-stay-time="60"
      catchtap="onAmountDone"
    >完成</view>
  </view>

  <!-- 日期：不允许选择未来日期（end 上限今天，提交层另有校验）。
       日期为今天时，行内出现「昨天 / 前天」快捷钮：补记昨天的账一步到位，
       不必「开 picker → 滚轮 → 确定」三步。切到过去日期后快捷钮自动隐藏。 -->
  <view class="bf-row bf-row--date">
    <text class="bf-row__label">日期</text>
    <view class="bf-quick">
      <!-- 今天：给出「昨天 / 前天」补记入口；已改成过去日期时收成一个「今天」退回入口 -->
      <view class="bf-chip" wx:if="{{dateStr !== todayStr}}" data-days="0" hover-class="bf-chip--hover" hover-stay-time="60" bindtap="onQuickDate">今天</view>
      <block wx:else>
        <view class="bf-chip" data-days="1" hover-class="bf-chip--hover" hover-stay-time="60" bindtap="onQuickDate">昨天</view>
        <view class="bf-chip" data-days="2" hover-class="bf-chip--hover" hover-stay-time="60" bindtap="onQuickDate">前天</view>
      </block>
    </view>
    <picker class="bf-date" mode="date" value="{{dateStr}}" end="{{todayStr}}" bindchange="onDate">
      <view class="bf-row__value bf-row__value--date">{{dateStr}} ›</view>
    </picker>
  </view>

  <!-- 计算日价（仅支出账单；开启后正常进账本，同时进入日价）。
       低频附加项 → 压成单行，不占主流程的纵向预算（原两行卡片会把分类与保存按钮顶出首屏）。 -->
  <view class="bf-daily" wx:if="{{type === 'expense'}}" bindtap="onToggleDaily">
    <text class="bf-daily__label">计算日价</text>
    <text class="bf-daily__sub">这笔消费每天值多少</text>
    <view class="bf-switch {{dailyValueEnabled ? 'bf-switch--on' : ''}}">
      <view class="bf-switch__knob"></view>
    </view>
  </view>

  <!-- 分类：最近使用 + 更多（换行网格，不横向滚动） -->
  <view class="bf-cats-head">
    <text class="bf-cats-label">分类</text>
    <text class="bf-cats-collapse" wx:if="{{showAllCats}}" bindtap="onHideAllCats">收起</text>
  </view>
  <view class="bf-cats-grid">
    <view
      wx:for="{{showAllCats ? allList : recentList}}"
      wx:key="id"
      class="bf-cat {{categoryId === item.id ? 'bf-cat--active' : ''}}"
      data-id="{{item.id}}"
      bindtap="onCategory"
    >
      <category-icon class="bf-cat__icon" icon-type="{{item.iconType}}" icon-value="{{item.iconValue}}" emoji="{{item.emoji}}" size="24"/>
      <text class="bf-cat__name">{{item.name}}</text>
    </view>
    <view wx:if="{{!showAllCats}}" class="bf-cat bf-cat--more" bindtap="onShowAllCats">
      <dv-icon class="bf-cat__more-icon" name="more" size="20" tone="secondary"></dv-icon>
      <text class="bf-cat__name">更多</text>
    </view>
  </view>

  <!-- 商户 -->
  <view class="bf-row">
    <text class="bf-row__label">商户</text>
    <input class="bf-row__input" type="text" placeholder="如：瑞幸咖啡" placeholder-class="bf-row__ph" value="{{merchant}}" bindinput="onMerchant" confirm-type="done" bindconfirm="onMerchantConfirm" />
  </view>

  <!-- 备注：上限 40 字（与周期页口径一致；WXML maxlength 挡真实按键，onNote 里另有兜底截断） -->
  <view class="bf-row">
    <text class="bf-row__label">备注</text>
    <input class="bf-row__input" type="text" placeholder="添加备注" placeholder-class="bf-row__ph" maxlength="40" value="{{note}}" bindinput="onNote" confirm-type="done" bindconfirm="onNoteConfirm" />
  </view>

  <!-- 删除（仅编辑模式） -->
  <view class="bf-delete" wx:if="{{editingId}}" bindtap="onDelete">
    <text>删除此账单</text>
  </view>

  <!-- 确认 -->
  <view class="bf-submit {{canSubmit ? '' : 'bf-submit--disabled'}}" bindtap="onSubmit">
    <text>{{editingId ? '保存修改' : '确认记一笔'}}</text>
  </view>
</view>
