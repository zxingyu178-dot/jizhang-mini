.bs-root {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 500;
}
.bs-root--hidden {
  visibility: hidden;
  pointer-events: none;
}

/* 遮罩：后景保留紫黑氛围，但遮到正文不可辨认（v0.8.1 真机收口） */
.bs-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: var(--sheet-mask);
  opacity: 0;
  transition: opacity 0.28s ease;
}
.bs-mask--show {
  opacity: 1;
}

/* 玻璃面板：半透明深色 + 顶部轻紫光 + 背景模糊 + 边缘高光。
   面板高度由内容驱动（不固定），max-height 作为上限；
   内容区高度由 JS 预算后内联给内部 scroll-view（见 bottom-sheet.wxml / utils/sheet-scroll.js）。 */
.bs-panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--glass-sheet);
  border-radius: 28rpx 28rpx 0 0;
  border-top: 1rpx solid var(--card-border);
  box-shadow: 0 -12rpx 48rpx rgba(0, 0, 0, 0.45);
  transform: translateY(100%);
  transition: transform 0.28s cubic-bezier(0.32, 0.72, 0, 1);
  max-height: 88%;
  display: flex;
  flex-direction: column;
  padding-bottom: env(safe-area-inset-bottom);
}
.bs-panel--show {
  transform: translateY(0);
}

.bs-handle {
  display: flex;
  justify-content: center;
  padding: 16rpx 0 6rpx;
  flex-shrink: 0;
}
.bs-handle__bar {
  width: 64rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: var(--switch-off-bg);
}

.bs-title {
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  padding: 10rpx 0 16rpx;
  flex-shrink: 0;
}

/* 内容区外壳：只负责排版，不参与滚动、不收缩（flex:0 1 auto 实测会把面板压塌）。
   高度全部来自内部 scroll-view 的确定 px 高度，内容装得下时不会多出一像素留白。 */
.bs-body {
  flex: 0 0 auto;
  min-height: 0;
}
.bs-scroll {
  display: block;
  width: 100%;
}
/* 滚动内容的自然高度盒：JS 用它量内容高（装得下 → 高度即内容高） */
.bs-body__inner {
  display: block;
  width: 100%;
}
