.bs-root {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 500;
}
.bs-root--hidden {
  visibility: hidden;
  pointer-events: none;
}

/* 遮罩：降低不透明度，让背景主页仍隐约可见 */
.bs-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.34);
  opacity: 0;
  transition: opacity 0.28s ease;
}
.bs-mask--show {
  opacity: 1;
}

/* 玻璃面板：半透明深色 + 顶部轻紫光 + 背景模糊 + 边缘高光。
   不依赖固定高度，按内容自然出现；max-height 作为上限。 */
.bs-panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background:
    linear-gradient(180deg, rgba(124, 134, 255, 0.16) 0%, rgba(124, 134, 255, 0) 240rpx),
    linear-gradient(180deg, rgba(26, 30, 54, 0.90) 0%, rgba(14, 18, 36, 0.92) 100%);
  border-radius: 28rpx 28rpx 0 0;
  border-top: 1rpx solid rgba(255, 255, 255, 0.16);
  box-shadow: 0 -12rpx 48rpx rgba(0, 0, 0, 0.45);
  transform: translateY(100%);
  transition: transform 0.28s cubic-bezier(0.32, 0.72, 0, 1);
  max-height: 88%;
  display: flex;
  flex-direction: column;
  padding-bottom: env(safe-area-inset-bottom);
}
.bs-panel--show {
  transform: translateY(0);
}

.bs-handle {
  display: flex;
  justify-content: center;
  padding: 16rpx 0 6rpx;
  flex-shrink: 0;
}
.bs-handle__bar {
  width: 64rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: rgba(255, 255, 255, 0.22);
}

.bs-title {
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  padding: 10rpx 0 16rpx;
  flex-shrink: 0;
}

/* 内容区按自然高度（不强制增长），内容超高时纵向滚动 */
.bs-body {
  flex: 0 1 auto;
  min-height: 0;
  overflow-y: auto;
}
