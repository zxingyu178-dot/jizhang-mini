.panel-scroll {
  height: 100%;
}
.acc {
  padding: 12rpx 28rpx 48rpx;
}
.month-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 8rpx 0 20rpx;
}
.month-title__text {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-primary);
}
.month-arrow {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  color: var(--text-secondary);
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.06);
}
.month-arrow--disabled {
  opacity: 0.3;
}
.acc__numbers {
  display: flex;
  flex-direction: column;
  padding: 28rpx;
  margin-bottom: 28rpx;
}
.num-block {
  margin-bottom: 26rpx;
}
.num-label {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-bottom: 8rpx;
}
.num-value {
  font-size: 46rpx;
  font-weight: 700;
  color: var(--text-primary);
}
.num-row {
  display: flex;
  flex-direction: row;
  height: 130rpx;
}
.num-half {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.num-half .num-value {
  font-size: 32rpx;
}
.day-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 8rpx 12rpx;
}
.day-head__label {
  font-size: 26rpx;
  color: var(--text-secondary);
  font-weight: 500;
}
.day-head__sum {
  font-size: 22rpx;
  color: var(--text-faint);
}
.day-card {
  margin-bottom: 20rpx;
  overflow: hidden;
}
.bill-item {
  display: flex;
  align-items: center;
  padding: 22rpx 24rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}
.bill-item:last-child {
  border-bottom: none;
}
.bill-item__emoji {
  font-size: 40rpx;
  width: 64rpx;
}
.bill-item__main {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
  margin: 0 16rpx;
}
.bill-item__name {
  font-size: 28rpx;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.bill-item__note {
  font-size: 22rpx;
  color: var(--text-faint);
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.bill-item__amount {
  font-size: 28rpx;
  font-weight: 600;
}
