.df {
  padding: 0 28rpx 28rpx;
  display: flex;
  flex-direction: column;
}

/* 名称行 */
.df-row {
  display: flex;
  align-items: center;
  padding: 24rpx 8rpx;
  border-bottom: 1rpx solid var(--divider);
}
.df-row__label {
  width: 130rpx;
  flex-shrink: 0;
  font-size: 28rpx;
  color: var(--text-secondary);
}
.df-row__value {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: var(--text-primary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
/* 普通输入（名称 / 备注）：与记账表单同一规格（60rpx + 行高 60rpx）。 */
.df-row__input {
  flex: 1;
  min-width: 0;
  height: var(--input-h-normal);
  line-height: var(--input-h-normal);
  padding: 0;
  box-sizing: border-box;
  font-size: 28rpx;
  color: var(--text-primary);
}
.df-row__ph {
  color: var(--text-faint);
}

/* 金额（明确高度 / 行高，避免机型原生 input baseline 差异导致下半部裁切） */
.df-amount {
  display: flex;
  align-items: center;
  height: 132rpx;
  box-sizing: border-box;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid var(--divider);
  margin-bottom: 24rpx;
}
.df-amount__sym {
  font-size: 44rpx;
  color: var(--text-secondary);
  margin-right: 12rpx;
  line-height: 100rpx;
}
.df-amount__input {
  flex: 1;
  height: var(--input-h-amount);
  line-height: var(--input-h-amount);
  padding: 0;
  box-sizing: border-box;
  font-size: 68rpx;
  font-weight: 700;
  color: var(--text-primary);
  min-width: 0;
}
.df-amount__ph {
  color: var(--text-faint);
  font-weight: 700;
}

/* 分类（换行网格） */
.df-cats-label {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin: 12rpx 0 10rpx;
}
.df-cats-grid {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 12rpx;
}
.df-cat {
  width: 25%;
  min-width: 0;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 14rpx 0;
  border-radius: 16rpx;
  overflow: hidden;
  transition: all 0.18s ease;
}
.df-cat--active {
  background: var(--primary-tint);
}
.df-cat__icon {
  margin-bottom: 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
/* 与记账表单 .bf-cat__name 统一：单行省略，避免 8 字分类名把格子撑高、上下错位。 */
.df-cat__name {
  max-width: 100%;
  padding: 0 6rpx;
  box-sizing: border-box;
  font-size: 22rpx;
  color: var(--text-secondary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.df-cat--active .df-cat__name {
  color: var(--text-primary);
}

/* 作用域说明 */
.df-hint {
  margin-top: 20rpx;
  padding: 0 8rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--text-faint);
}

/* 确认按钮（减重，与 bill-form 统一） */
.df-submit {
  margin-top: 24rpx;
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--button-primary-text);
  border-radius: 18rpx;
  background: var(--button-primary);
  border: none;
  box-shadow: var(--button-primary-shadow);
}
.df-submit--disabled {
  background: var(--button-disabled);
  color: var(--button-disabled-text);
  border: none;
  box-shadow: none;
}
