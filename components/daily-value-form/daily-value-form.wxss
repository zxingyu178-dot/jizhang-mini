.df {
  padding: 0 28rpx 28rpx;
  display: flex;
  flex-direction: column;
}

/* 名称行 */
.df-row {
  display: flex;
  align-items: center;
  padding: 24rpx 8rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}
.df-row__label {
  width: 130rpx;
  flex-shrink: 0;
  font-size: 28rpx;
  color: var(--text-secondary);
}
.df-row__value {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-primary);
}
.df-row__input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-primary);
  min-width: 0;
}
.df-row__ph {
  color: rgba(255, 255, 255, 0.25);
}

/* 金额 */
.df-amount {
  display: flex;
  align-items: center;
  padding: 12rpx 0 28rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
  margin-bottom: 24rpx;
}
.df-amount__sym {
  font-size: 44rpx;
  color: var(--text-secondary);
  margin-right: 12rpx;
}
.df-amount__input {
  flex: 1;
  font-size: 72rpx;
  font-weight: 700;
  color: var(--text-primary);
  min-width: 0;
}
.df-amount__ph {
  color: rgba(255, 255, 255, 0.22);
  font-weight: 700;
}

/* 分类横向滚动 */
.df-cats {
  margin-bottom: 20rpx;
}
.df-cats__inner {
  display: flex;
  padding: 4rpx 0;
}
.df-cat {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 120rpx;
  padding: 16rpx 0;
  margin-right: 12rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid transparent;
  transition: all 0.18s ease;
}
.df-cat--active {
  background: rgba(124, 134, 255, 0.18);
  border-color: rgba(124, 134, 255, 0.55);
}
.df-cat__emoji {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}
.df-cat__name {
  font-size: 22rpx;
  color: var(--text-secondary);
}
.df-cat--active .df-cat__name {
  color: var(--text-primary);
}

/* 作用域说明 */
.df-hint {
  margin-top: 20rpx;
  padding: 0 8rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--text-faint);
}

/* 确认按钮 */
.df-submit {
  margin-top: 28rpx;
  padding: 28rpx 0;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #7c86ff 0%, #5b67f0 100%);
  box-shadow: 0 10rpx 28rpx rgba(91, 103, 240, 0.4);
}
.df-submit--disabled {
  opacity: 0.45;
  box-shadow: none;
}
