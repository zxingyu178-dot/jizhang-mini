<view class="cd" style="width:{{size}}px;height:{{size}}px;">
  <image class="cd__img" src="{{uri}}" style="width:{{size}}px;height:{{size}}px;" mode="aspectFit"/>
  <view class="cd__center">
    <text class="cd__amount">{{centerText}}</text>
    <text class="cd__label">{{centerLabel}}</text>
  </view>
</view>
