<view class="sta-wrap">
<scroll-view scroll-y class="panel-scroll" enhanced show-scrollbar="{{false}}" scroll-into-view="{{scrollInto}}">
  <view class="sta">
    <!-- 月度 / 年度切换 + 模块管理入口 -->
    <view class="seg-row">
      <view class="seg">
        <view class="seg__item {{mode==='month'?'seg__item--active':''}}" bindtap="onModeMonth">月度</view>
        <view class="seg__item {{mode==='year'?'seg__item--active':''}}" bindtap="onModeYear">年度</view>
      </view>
      <view class="manage-btn" bindtap="onOpenManage">
        <text class="manage-btn__text">管理</text>
      </view>
    </view>

    <!-- ================= 月度 ================= -->
    <block wx:if="{{mode==='month'}}">
      <view class="month-title">
        <view class="month-arrow" bindtap="onPrevMonth">‹</view>
        <text class="month-title__text">{{monthLabel}}</text>
        <view class="month-arrow {{canNextMonth?'':'month-arrow--disabled'}}" bindtap="onNextMonth">›</view>
      </view>

      <!-- Hero -->
      <view class="glass-card hero">
        <text class="hero__label">本月支出</text>
        <text class="hero__big money-expense">¥{{mExpense}}</text>
        <view class="hero__foot">
          <view class="hero__half">
            <text class="hero__sub-label">收入</text>
            <text class="hero__sub money-income">¥{{mIncome}}</text>
          </view>
          <view class="hero__half">
            <text class="hero__sub-label">结余</text>
            <text class="hero__sub">¥{{mBalance}}</text>
          </view>
        </view>
        <view class="hero__foot hero__foot--three">
          <view class="hero__third">
            <text class="hero__sub-label">记录</text>
            <text class="hero__sub">{{mCount}} 笔</text>
          </view>
          <view class="hero__third">
            <text class="hero__sub-label">最高消费日</text>
            <text class="hero__sub">{{mTopDay}} {{mTopDayAmount}}</text>
          </view>
          <view class="hero__third">
            <text class="hero__sub-label">日均支出</text>
            <text class="hero__sub">{{mDailyAvg}}</text>
          </view>
        </view>
      </view>

      <!-- 最大单笔支出（点击打开账单编辑） -->
      <view class="glass-card largest" wx:if="{{mLargest}}" bindtap="onTapMonthLargest">
        <view class="largest__icon">
          <category-icon icon-type="{{mLargest.iconType}}" icon-value="{{mLargest.iconValue}}" emoji="{{mLargest.emoji}}" size="22"/>
        </view>
        <view class="largest__main">
          <text class="largest__label">最大单笔支出</text>
          <text class="largest__sub">{{mLargest.dateLabel}} · {{mLargest.title}}</text>
        </view>
        <text class="largest__amount money-expense">{{mLargest.amountText}}</text>
      </view>

      <!-- 分类占比（环形图 + 分类列表，点击真实分类钻取 Bill Explorer） -->
      <view class="glass-card chart share" wx:if="{{modMap['category-share']}}">
        <text class="chart__title">分类占比</text>
        <category-donut
          segments="{{shareSegments}}"
          center-text="¥{{mExpense}}"
          center-label="总支出"
          size="150"
        />
        <view class="share-list">
          <view
            class="share-row"
            wx:for="{{shareExpanded ? fullShareList : shareList}}"
            wx:key="categoryId"
            data-id="{{item.categoryId}}"
            data-agg="{{item.aggregate}}"
            bindtap="onTapShareRow"
          >
            <view class="share-row__icon">
              <category-icon icon-type="{{item.iconType}}" icon-value="{{item.iconValue}}" emoji="{{item.emoji}}" size="19"/>
            </view>
            <text class="share-row__name">{{item.name}}</text>
            <text class="share-row__amount money-expense">¥{{item.centsText}}</text>
            <text class="share-row__percent">{{item.percentText}}%</text>
          </view>
        </view>
        <view class="share-toggle" wx:if="{{shareAggregated}}" bindtap="onToggleShareExpand">
          <text class="share-toggle__text">{{shareExpanded ? '收起' : '查看全部分类'}}</text>
        </view>
      </view>

      <!-- 每日花费趋势 -->
      <view class="glass-card chart" wx:if="{{modMap['daily-expense-trend']}}">
        <text class="chart__title">每日花费趋势</text>
        <view class="chart__bars chart__bars--daily">
          <view class="bar-col" wx:for="{{daily}}" wx:key="day">
            <view class="bar bar--exp" style="height:{{item.barHeightRpx}}rpx;"></view>
            <text class="bar-label {{item.showLabel?'':'bar-label--hide'}}">{{item.label}}</text>
          </view>
        </view>
      </view>

      <!-- 累计消费趋势（默认关闭，在管理中开启） -->
      <view class="glass-card chart" id="cumCard" wx:if="{{modMap['cumulative-trend']}}">
        <text class="chart__title">累计消费趋势</text>
        <cumulative-trend points="{{cumPoints}}" max="{{cumMax}}" width="320" height="180"/>
      </view>

      <!-- 预算空态：从未设置过预算规则（不显示整页灰色日历） -->
      <view class="glass-card chart bcal-empty" wx:if="{{modMap['budget-analysis'] && budgetEmpty}}">
        <text class="chart__title">预算分析</text>
        <empty-state
          compact
          primary
          title="还没有设置预算"
          desc="设置每日预算后，可以查看每天的盈余与超支"
          action-text="设置预算"
          bind:action="onBudgetSettings"
        />
      </view>

      <!-- 预算日历地图（绿盈余 / 红超支 / 灰无预算或未来 / 紫描边今天） -->
      <view class="glass-card chart bcal" wx:if="{{modMap['budget-analysis'] && budgetCalendar}}">
        <text class="chart__title">{{monthLabel}}预算日历</text>
        <view class="bcal__heads">
          <text class="bcal__head" wx:for="{{budgetCalendar.weekHeaders}}" wx:key="*this">{{item}}</text>
        </view>
        <view class="bcal__weeks">
          <view class="bcal__week" wx:for="{{budgetCalendar.weeks}}" wx:for-item="week" wx:for-index="wi" wx:key="wi">
            <view
              class="bcal__cell bcal__cell--{{cell.state}} bcal__lv{{cell.level}} {{cell.inMonth?'':'bcal__cell--outm'}} {{cell.isToday?'bcal__cell--today':''}}"
              wx:for="{{week}}"
              wx:for-item="cell"
              wx:key="dateStr"
              data-date="{{cell.inMonth?cell.dateStr:''}}"
              bindtap="onTapDay"
            >
              <text class="bcal__num">{{cell.day}}</text>
            </view>
          </view>
        </view>

        <!-- 图例（一行：盈余 / 超支 / 无预算 / 今天） -->
        <view class="blegend">
          <view class="blegend__item"><view class="blegend__dot blegend__dot--surplus"></view><text>盈余</text></view>
          <view class="blegend__item"><view class="blegend__dot blegend__dot--over"></view><text>超支</text></view>
          <view class="blegend__item"><view class="blegend__dot blegend__dot--none"></view><text>无预算</text></view>
          <view class="blegend__item"><view class="blegend__dot blegend__dot--today"></view><text>今天</text></view>
        </view>

        <!-- 预算节奏摘要 -->
        <view class="pace">
          <view class="pace__item" wx:for="{{pace}}" wx:key="label">
            <text class="pace__label">{{item.label}}</text>
            <text class="pace__val {{item.positive?'budget-surplus':'budget-over'}}" wx:if="{{item.hasBudget}}">{{item.text}}</text>
            <text class="pace__val pace__val--none" wx:else>—</text>
          </view>
        </view>
      </view>

      <!-- 收入 / 支出对比 -->
      <view class="glass-card chart" wx:if="{{modMap['income-expense-compare']}}">
        <text class="chart__title">收入 / 支出对比</text>
        <view class="cmp-row">
          <text class="cmp-label">支出</text>
          <view class="cmp-track"><view class="cmp-fill cmp-fill--exp" style="width:{{cmp.expenseBar}}%;"></view></view>
          <text class="cmp-val money-expense">¥{{cmp.expense}}</text>
        </view>
        <view class="cmp-row">
          <text class="cmp-label">收入</text>
          <view class="cmp-track"><view class="cmp-fill cmp-fill--inc" style="width:{{cmp.incomeBar}}%;"></view></view>
          <text class="cmp-val money-income">¥{{cmp.income}}</text>
        </view>
      </view>

      <!-- 自定义日期统计 -->
      <view class="glass-card chart" wx:if="{{modMap['custom-range']}}">
        <text class="chart__title">自定义日期统计</text>
        <view class="cr-pickers">
          <picker mode="date" value="{{crStart}}" end="{{crMaxStart}}" bindchange="onCrStart" class="cr-picker">
            <view class="cr-picker__box">
              <text class="cr-picker__label">开始</text>
              <text class="cr-picker__value">{{crStart}}</text>
            </view>
          </picker>
          <text class="cr-sep">至</text>
          <picker mode="date" value="{{crEnd}}" end="{{crMaxEnd}}" bindchange="onCrEnd" class="cr-picker">
            <view class="cr-picker__box">
              <text class="cr-picker__label">结束</text>
              <text class="cr-picker__value">{{crEnd}}</text>
            </view>
          </picker>
        </view>
        <view class="cr-invalid" wx:if="{{crInvalid}}">
          <text class="cr-invalid__text">开始日期不能晚于结束日期</text>
        </view>
        <view class="cr-stats" wx:if="{{crStats}}">
          <view class="cr-stat">
            <text class="cr-stat__label">支出</text>
            <text class="cr-stat__value money-expense">¥{{crStats.expense}}</text>
          </view>
          <view class="cr-stat">
            <text class="cr-stat__label">收入</text>
            <text class="cr-stat__value money-income">¥{{crStats.income}}</text>
          </view>
          <view class="cr-stat">
            <text class="cr-stat__label">结余</text>
            <text class="cr-stat__value">{{crStats.balance}}</text>
          </view>
          <view class="cr-stat">
            <text class="cr-stat__label">账单数</text>
            <text class="cr-stat__value">{{crStats.count}} 笔</text>
          </view>
        </view>
      </view>
    </block>

    <!-- ================= 年度 ================= -->
    <block wx:if="{{mode==='year'}}">
      <view class="month-title">
        <view class="month-arrow" bindtap="onPrevYear">‹</view>
        <text class="month-title__text">{{year}}年</text>
        <view class="month-arrow {{canNextYear?'':'month-arrow--disabled'}}" bindtap="onNextYear">›</view>
      </view>

      <!-- Hero -->
      <view class="glass-card hero">
        <text class="hero__label">{{year}}年支出</text>
        <text class="hero__big money-expense">¥{{yExpense}}</text>
        <view class="hero__foot">
          <view class="hero__half">
            <text class="hero__sub-label">收入</text>
            <text class="hero__sub money-income">¥{{yIncome}}</text>
          </view>
          <view class="hero__half">
            <text class="hero__sub-label">结余</text>
            <text class="hero__sub">¥{{yBalance}}</text>
          </view>
        </view>
        <view class="hero__foot">
          <view class="hero__half">
            <text class="hero__sub-label">记录</text>
            <text class="hero__sub">{{yCount}} 笔</text>
          </view>
          <view class="hero__half">
            <text class="hero__sub-label">月均支出</text>
            <text class="hero__sub">¥{{yAvg}}</text>
          </view>
        </view>
      </view>

      <!-- 极值 -->
      <view class="glass-card chart">
        <view class="ext-row">
          <view class="ext-half">
            <text class="ext-label">最高消费月</text>
            <text class="ext-val">{{highest}}</text>
          </view>
          <view class="ext-half">
            <text class="ext-label">最低消费月</text>
            <text class="ext-val">{{lowest}}</text>
          </view>
        </view>
      </view>

      <!-- 年度回顾：最大单笔 / 记录最多分类 / 最常消费月份（可点击钻取） -->
      <view class="glass-card chart" wx:if="{{modMap['year-review'] && (yrLargest || yrTopCat || yrTopMonth)}}">
        <text class="chart__title">年度回顾</text>
        <view class="yr-row" wx:if="{{yrLargest}}" bindtap="onTapYrLargest">
          <view class="yr-row__main">
            <text class="yr-row__label">最大单笔支出</text>
            <view class="yr-row__sub">
              <text class="yr-row__subtext">{{yrLargest.dateLabel}} · {{yrLargest.title}}</text>
            </view>
          </view>
          <text class="yr-row__val money-expense">{{yrLargest.amountText}}</text>
        </view>
        <view class="yr-row" wx:if="{{yrTopCat}}" bindtap="onTapYrTopCat">
          <view class="yr-row__main">
            <text class="yr-row__label">记录最多的分类</text>
            <view class="yr-row__sub">
              <view class="yr-row__emoji"><category-icon icon-type="{{yrTopCat.iconType}}" icon-value="{{yrTopCat.iconValue}}" emoji="{{yrTopCat.emoji}}" size="20"/></view>
              <text class="yr-row__subtext">{{yrTopCat.name}} · {{yrTopCat.count}}笔</text>
            </view>
          </view>
          <text class="yr-row__arrow">›</text>
        </view>
        <view class="yr-row" wx:if="{{yrTopMonth}}" bindtap="onTapYrTopMonth">
          <view class="yr-row__main">
            <text class="yr-row__label">最常消费月份</text>
            <view class="yr-row__sub">
              <text class="yr-row__subtext">{{yrTopMonth.label}} · {{yrTopMonth.count}}笔</text>
            </view>
          </view>
          <text class="yr-row__arrow">›</text>
        </view>
      </view>

      <!-- 12 个月趋势 -->
      <view class="glass-card chart" wx:if="{{modMap['year-monthly-trend']}}">
        <text class="chart__title">12 个月支出趋势</text>
        <view class="chart__bars chart__bars--month">
          <view class="bar-col bar-col--tap" wx:for="{{monthly}}" wx:key="month" data-month="{{item.month}}" bindtap="onTapMonthBar">
            <view class="bar bar--exp" style="height:{{item.barHeightRpx}}rpx;"></view>
            <text class="bar-label {{item.showLabel?'':'bar-label--hide'}}">{{item.label}}</text>
          </view>
        </view>
      </view>

      <!-- 全年分类占比（复用 category-donut，使用完整年度分类列表） -->
      <view class="glass-card chart share" id="yearShareCard">
        <text class="chart__title">全年分类占比</text>
        <block wx:if="{{yearShareList.length}}">
          <category-donut
            segments="{{yearShareSegments}}"
            center-text="¥{{yExpense}}"
            center-label="全年支出"
            size="150"
          />
          <view class="share-list">
            <view
              class="share-row"
              wx:for="{{yearShareExpanded ? yearFullShareList : yearShareList}}"
              wx:key="categoryId"
              data-id="{{item.categoryId}}"
              data-agg="{{item.aggregate}}"
              bindtap="onTapYearShareRow"
            >
              <view class="share-row__icon">
                <category-icon icon-type="{{item.iconType}}" icon-value="{{item.iconValue}}" emoji="{{item.emoji}}" size="19"/>
              </view>
              <text class="share-row__name">{{item.name}}</text>
              <text class="share-row__amount money-expense">¥{{item.centsText}}</text>
              <text class="share-row__percent">{{item.percentText}}%</text>
            </view>
          </view>
          <view class="share-toggle" wx:if="{{yearShareAggregated}}" bindtap="onToggleYearShareExpand">
            <text class="share-toggle__text">{{yearShareExpanded ? '收起' : '查看全部分类'}}</text>
          </view>
        </block>
        <view class="chart__empty" wx:else>这一年还没有支出</view>
      </view>
    </block>

    <view class="sta__bottom"></view>
  </view>
</scroll-view>

  <!-- 模块管理 Bottom Sheet（放在 scroll-view 外，避免内部 fixed 定位异常） -->
  <bottom-sheet show="{{showManage}}" title="我的统计" bind:close="onCloseManage">
    <view class="mgr-list">
      <view class="mgr-row" wx:for="{{moduleRows}}" wx:key="id">
        <text class="mgr-row__label">{{item.label}}</text>
        <switch
          class="mgr-row__switch"
          checked="{{item.checked}}"
          data-id="{{item.id}}"
          color="#7c86ff"
          bindchange="onToggleModule"
        />
      </view>
    </view>
    <view class="mgr-reset" bindtap="onResetModules">
      <text class="mgr-reset__text">恢复默认</text>
    </view>
  </bottom-sheet>
</view>
