/* flex 列布局：外层包裹 view 撑满 swiper-item，内层 scroll-view 用 flex:1 + min-height:0
   才能在 Skyline 下正确识别内容溢出并滚动（直接让 scroll-view height:100% 会导致
   scrollHeight 被算成 clientHeight，长页面无法滚动）。 */
.sta-wrap {
  height: 100%;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}
.panel-scroll {
  flex: 1;
  min-height: 0;
  width: 100%;
}
.sta {
  padding: 12rpx 28rpx 48rpx;
}

/* ---- 月度 / 年度 分段控件 ---- */
.seg {
  display: flex;
  flex-direction: row;
  background: var(--surface);
  border-radius: 999rpx;
  padding: 6rpx;
  margin: 8rpx 0 20rpx;
}
.seg__item {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-secondary);
  padding: 12rpx 0;
  border-radius: 999rpx;
  transition: all 0.18s;
}
.seg__item--active {
  color: var(--button-primary-text);
  font-weight: 600;
  /* v1.4.5：底与字必须配对。写死 primary→primary-deep 渐变时，深色主题的深色按钮字
     压在 primary-deep 端只有 4.29（<4.5），改用 --button-primary（按模式取底）+ 配套字色 */
  background: var(--button-primary);
  box-shadow: 0 6rpx 18rpx var(--primary-glow);
}

/* ---- 月份 / 年份 切换 ---- */
.month-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 8rpx 0 20rpx;
}
.month-title__text {
  flex: 1;
  min-width: 0;
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-primary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.month-arrow {
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  color: var(--text-secondary);
  border-radius: 50%;
  background: var(--surface);
}
.month-arrow--disabled {
  opacity: 0.3;
}

/* ---- Hero 主卡 ---- */
.hero {
  padding: 32rpx;
  margin-bottom: 28rpx;
}
/* 第一行（v1.4.6）：label 与「同期环比」同一基线左右分布。
   ⚠️ 只新增容器，未改 .hero__label 的任何声明（字号 / 颜色 / 字重原样），
   .hero__big / .hero__foot / .hero__third 也未动 —— stats-hero-layout.test.js 有 47 条契约盯着。 */
.hero__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
.hero__label {
  font-size: 24rpx;
  color: var(--text-secondary);
}
/* 同期环比（B-2 第二批）。颜色决策：
   本项目 --expense 是绿 #3ddc8f、--income 是红 #ff6b6b（既有设计，⛔ 不改），
   与常见记账 app 相反 —— 若按「支出变多 = 警示」染红，就和全项目的「支出=绿」打架；
   若按「支出=绿」染色，「花得更多」又被染成好事，同样错。
   两个方向都会传出错误语义，故统一取中性 --text-axis（= 刻度同档，
   深色 7.23:1 / 浅色 5.74:1，见 v1.4.4 实测），涨跌只靠文字本身表达。 */
.hero__mom {
  font-size: 11px;
  color: var(--text-axis);
}
/* 方向钩子：--up / --down 由 data 决定，本轮统一中性色（见上）；留钩子便于后续接入正确语义色 */
.hero__mom--up,
.hero__mom--down {
  color: var(--text-axis);
}
/* 窄屏（≤360px）：Skyline 下宽度媒体查询不生效，由 JS 判定挂类（与 .hero__foot--three--narrow 同一做法） */
.hero__mom--narrow {
  font-size: 10px;
}
.hero__big {
  display: block;
  font-size: 72rpx;
  font-weight: 800;
  margin: 12rpx 0 24rpx;
  letter-spacing: 1rpx;
}
.hero__foot {
  display: flex;
  flex-direction: row;
  padding-top: 22rpx;
  border-top: 1rpx solid var(--divider);
}
.hero__half {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.hero__sub-label {
  font-size: 22rpx;
  color: var(--text-faint);
}
.hero__sub {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-top: 6rpx;
}
/* Hero 第二行：记录 / 最高消费日 / 日均（3 列，字号略小防溢出） */
.hero__foot--three {
  margin-top: 22rpx;
}
.hero__third {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
  padding-right: 10rpx;
}
/* 中间列承载「日期 + 金额」，给更高弹性；两侧仅计数 / 单价，保持原三列不变 */
.hero__foot--three .hero__third:nth-child(2) {
  flex: 1.6;
  padding-right: 0;
}
.hero__foot--three .hero__third .hero__sub {
  font-size: 26rpx;
  white-space: nowrap;
}
/* 窄屏（≤360px）：进一步收字号，保证长日期 + 长金额仍单行完整显示。
   ⚠️ 本项目 app.json 为 `renderer: skyline`，Skyline 的 WXSS 媒体查询官方只支持 DarkMode，
   宽度断点（min/max-width）不生效 —— 所以这里不再用 @media，改由 JS 判定挂类：
   statistics-panel.js 在 attached 里用 utils/device.js 的 isNarrowScreen()（windowWidth ≤ 360）
   给 .hero__foot--three 追加 .hero__foot--three--narrow（见 wxml）。阈值口径与原
   `@media (max-width: 360px)` 完全一致；两类选择器与基础规则同特异性但位置在后，
   故窄屏下稳定覆盖 26rpx / flex 1.6。 */
.hero__foot--three--narrow .hero__third .hero__sub {
  font-size: 22rpx;
}
.hero__foot--three--narrow .hero__third:nth-child(2) {
  flex: 1.7;
}

/* ---- 最大单笔支出卡（v1.3.0） ---- */
.largest {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 24rpx 28rpx;
  margin-bottom: 28rpx;
}
.largest__icon {
  width: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.largest__main {
  flex: 1;
  min-width: 0;
  margin: 0 16rpx;
  display: flex;
  flex-direction: column;
}
.largest__label {
  font-size: 24rpx;
  color: var(--text-secondary);
}
.largest__sub {
  font-size: 26rpx;
  color: var(--text-primary);
  margin-top: 6rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.largest__amount {
  flex-shrink: 0;
  margin-left: 12rpx;
  font-size: 34rpx;
  font-weight: 700;
  white-space: nowrap;
}

/* ---- 分类占比列表（v1.3.0） ---- */
.share-list {
  margin-top: 12rpx;
}
.share-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 12rpx 0;
}
.share-row__dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin-right: 12rpx;
  flex-shrink: 0;
}
.share-row--active {
  background: rgba(124, 134, 255, 0.12);
  border-radius: 12rpx;
}
.share-row__icon {
  width: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.share-row__name {
  flex: 1;
  min-width: 0;
  margin: 0 12rpx;
  font-size: 26rpx;
  color: var(--text-primary);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.share-row__amount {
  flex-shrink: 0;
  font-size: 26rpx;
  font-weight: 600;
  white-space: nowrap;
}
.share-row__percent {
  flex-shrink: 0;
  /* v1.4.3：原固定 80rpx 装不下「100.0%」，大额账单时会被折成「100.0」+「%」两行 */
  min-width: 80rpx;
  margin-left: 12rpx;
  text-align: right;
  white-space: nowrap;
  font-size: 24rpx;
  color: var(--text-secondary);
}
/* 「其他」分组头：顶部分隔 + 名称加粗，与普通行区分 */
.share-row--group {
  border-top: 1rpx solid var(--divider);
  margin-top: 6rpx;
}
.share-row--group .share-row__name {
  font-weight: 700;
}
/* 被聚合子分类：缩进、字号弱化，视觉上从属于「其他」分组 */
.share-row--child {
  padding-left: 42rpx;
}
.share-row--child .share-row__name {
  font-size: 24rpx;
  color: var(--text-secondary);
}
/* 分组 / 子分类语义小标签 */
.share-row__tag {
  font-size: 20rpx;
  color: var(--text-faint);
  margin-right: 12rpx;
  flex-shrink: 0;
  white-space: nowrap;
}
.share-toggle {
  margin-top: 12rpx;
  padding: 12rpx 0;
  text-align: center;
}
.share-toggle__text {
  font-size: 24rpx;
  color: var(--primary-text);
}

/* ---- 图表卡 ---- */
.chart {
  padding: 28rpx;
  margin-bottom: 28rpx;
}
.chart__title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 24rpx;
}
/* ---- 图表结论行（B-2 第一批）：标题下的一句话总结 ----
   1) 字号 11px 与坐标轴刻度同档（不用 rpx：窄屏 rpx 会缩到 9px 以下，直接看不清）；
   2) 颜色吃 --text-axis（刻度同档，v1.4.4 已验证深/浅主题对比度 4.78~7.72:1）。
      ⛔ 不用 --text-faint：深色 2.30:1，糊在玻璃卡背景上看不见；
   3) 标题自带 margin-bottom:24rpx，结论行要贴着标题 → margin-top:-20rpx 抵掉，
      净间距 4rpx 且 24 + (-20) 相邻外边距折叠 / 相加都等于 4rpx；
      ⛔ 不改 .chart__title 的任何声明（v1.4.4 的卡片间距是验收过的）；
   4) 折行（v1.4.6 P2 修补）：原先 nowrap + ellipsis 会把大额文案切成
      「…月末约 ¥3,827…」——数字被砍半截比换行难读得多。
      现在改为 flex + flex-wrap，**每个金额 / 词是一个原子的 seg（nowrap）**，
      渲染层只能在 seg 之间换行，物理上不可能在 '¥1,234,567' 内部断开。
      ⛔ 不用 overflow-wrap: break-word（那是「任意位置断」，数字照样会被切开）；
      ⛔ 不做多行省略（结论行宁可占两行，也不许藏数字）。 */
.chart__insight {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  font-size: 11px;
  line-height: 1.4;
  color: var(--text-axis);
  margin-top: -20rpx;
  margin-bottom: 20rpx;
}
/* 段与段之间 4px（≈ 11px 字号下一个空格），段内文字不换行 */
.chart__insight__seg {
  flex: 0 0 auto;
  white-space: nowrap;
  margin-right: 4px;
}
/* 窄屏（≤360px）：Skyline 下宽度媒体查询不生效，由 JS 判定后挂本 class（与 Hero --narrow 同一做法） */
.chart__insight--narrow {
  font-size: 10px;
}

.chart__empty {
  font-size: 24rpx;
  /* v1.4.4 终检：空态文案是「本卡主体信息」，不是可有可无的辅助字。
     原 --text-faint（深色 2.30:1）糊在玻璃卡背景上，改用刻度同一档 --text-axis。 */
  color: var(--text-axis);
  padding: 24rpx 0;
  text-align: center;
}

/* ---- 柱状图（纯 WXSS） ---- */
/* v1.4.4：柱图改为「Y 轴刻度列 + 柱区 + X 标签行」三段结构。
   刻度文字与网格线全部落在左侧留白列 / 柱区内部绝对定位，不用 overflow 裁剪
   （Skyline 下 overflow 行为与 WebView 不同，柱子不能靠裁剪收边）。 */
.ca {
  display: block;
}
.ca__row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
}
.ca__ycol {
  position: relative;
  flex-shrink: 0;
}
.ca__tick {
  position: absolute;
  right: 6px;
  line-height: 1;
  white-space: nowrap;
  text-align: right;
  /* v1.4.4 终检：刻度专用色（--text-axis）。--text-faint 是「辅助文字」色，
     坐标轴要读数，不能吃 0.40（浅色实测 2.3:1） */
  color: var(--text-axis);
  transform: translateY(50%);
  pointer-events: none;
}
.ca__plot {
  position: relative;
  flex: 1;
  min-width: 0;
}
.ca__grid {
  position: absolute;
  left: 0;
  right: 0;
  height: 1px;
  /* 网格线专用色（--chart-grid）：--divider 做网格线太淡（浅色实测 1.13:1） */
  background: var(--chart-grid);
  /* 1px 线在 rpx 取整后系统性偏高约 0.5~1.4px，下移 1px 与刻度文字对齐 */
  transform: translateY(1px);
}
/* ---- 柱体（v1.5.3）：SVG 图 ----
   柱子不再是 view，改为 1 张 SVG 图覆盖整个柱区（6 档明暗台阶在 utils/bar-shading 里生成）。
   这里只负责「铺满柱区、且不参与 flex 布局」：
   绝对定位 → 不占 flex 位，柱区高度仍由 .ca__plot 的内联 height 决定（数据几何零变更）；
   高度另由 WXML 内联 rpx 兜一层，不依赖百分比高度解析。 */
.ca__bars-img {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  display: block;
  /* 图背景透明：柱脚槽 / 0 档网格线仍从柱间空隙露出来 */
  background: transparent;
}
.ca__xrow {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  height: 34rpx;
}
.bar-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  align-items: center;
  min-width: 0;
}
.bar-col--tap {
  /* 年度 12 月趋势可点：点击反馈 */
}
.bar-col--tap:active {
  opacity: 0.55;
}
/* ---- 柱体样式已下线（v1.5.3）----
   .bar / .bar--exp 两条规则随「柱子改图」一起删除，留着只会误导后人以为柱子还是 view。
   历史结论（v1.5.1 实测，保留下来防止有人再试一遍）：
     多色标硬停渐变在组件 WXSS 里会被整条丢掉 —— 读计算样式 background-image 恒为 null
     （background-color 正常生效），柱体像素自上而下无任何台阶；同样的渐变用行内样式注入
     同一元素则正常渲染。三种写法（长写 / background 同层简写 / 简写 + background-color）均不生效。
   现在的 6 档台阶在 utils/bar-shading.js（生成 SVG 逐档矩形），与本文件的 CSS 变量无关；
   app.wxss 的 --bar-cap/-lit/-shade/-foot 仍保留为「明暗比例的唯一文字出处」，值由测试锁住不许漂。 */

/* ---- 柱后地面槽（v1.5.1）----
   让柱子「站在一条浅槽里」，不是贴在卡片上。中性黑/白，不参与主题色色相合同。
   必须是 .ca__plot 的第一个子节点（DOM 顺序 = 绘制顺序）：放在网格线之后会盖住 0 档网格线，
   数据底线的读数依据就没了；放在网格线之前，网格线与柱子都压在它上面，
   槽只在柱间空隙露出来 —— 正是要的效果。 */
.ca__plate {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 6rpx;
  background: var(--bar-plate);
  border-top: 1rpx solid var(--bar-lip);
  pointer-events: none;
}
.bar-label {
  /* 不再写死 60rpx（≈34px）：12 列时列宽只有 ≈26px，写死会让相邻标签的可点区域重叠 8px，
     点 3 月却命中 4 月。改为撑满本列 + 居中，点哪个月就命中哪个月。 */
  width: 100%;
  flex-shrink: 0;
  white-space: nowrap;
  height: 34rpx;
  line-height: 34rpx;
  font-size: 22rpx; /* 11px：字号由 JS 按窗口宽度内联覆盖（正常 11 / 窄屏 10） */
  color: var(--text-axis);
  text-align: center;
}
.bar-label--hide {
  opacity: 0;
}

/* ---- 分类排行 ---- */
.rank-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 18rpx 0;
}
.rank-emoji {
  font-size: 36rpx;
  width: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.rank-main {
  flex: 1;
  min-width: 0;
  margin: 0 16rpx;
}
.rank-line {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 10rpx;
}
.rank-name {
  font-size: 26rpx;
  color: var(--text-primary);
}
.rank-amount {
  font-size: 26rpx;
  font-weight: 600;
}
.rank-bar {
  height: 10rpx;
  border-radius: 999rpx;
  background: var(--surface);
  overflow: hidden;
}
.rank-bar__fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, var(--primary), var(--primary-deep));
}
.rank-percent {
  width: 64rpx;
  text-align: right;
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* ---- 收入 / 支出对比 ---- */
.cmp-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 12rpx 0;
}
.cmp-label {
  width: 72rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}
.cmp-track {
  flex: 1;
  height: 20rpx;
  border-radius: 999rpx;
  background: var(--surface);
  overflow: hidden;
  margin: 0 16rpx;
}
.cmp-fill {
  height: 100%;
  border-radius: 999rpx;
}
.cmp-fill--exp {
  background: var(--expense);
}
.cmp-fill--inc {
  background: var(--income);
}
/* 金额列不再写死 140rpx：7 位以上金额（¥1,234,567.89）在 320px 屏 + tabular-nums
   下会顶满 140rpx 甚至折行。改为「最小宽度 + 不收缩 + 单行」，由中间的进度条让位。 */
.cmp-val {
  flex-shrink: 0;
  min-width: 140rpx;
  text-align: right;
  font-size: 24rpx;
  font-weight: 600;
  white-space: nowrap;
}

/* ---- 极值 ---- */
.ext-row {
  display: flex;
  flex-direction: row;
}
.ext-half {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.ext-label {
  font-size: 22rpx;
  color: var(--text-faint);
}
.ext-val {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-top: 8rpx;
}

/* 年度回顾三项（Gate 5） */
.yr-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--divider);
}
.yr-row:last-child {
  border-bottom: none;
}
.yr-row:active {
  opacity: 0.6;
}
.yr-row__main {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.yr-row__label {
  font-size: 22rpx;
  color: var(--text-faint);
}
.yr-row__sub {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 8rpx;
  min-width: 0;
}
.yr-row__emoji {
  font-size: 26rpx;
  margin-right: 10rpx;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}
.yr-row__subtext {
  font-size: 27rpx;
  font-weight: 600;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.yr-row__val {
  font-size: 28rpx;
  font-weight: 700;
  margin-left: 16rpx;
  flex-shrink: 0;
}
.yr-row__arrow {
  font-size: 40rpx;
  color: var(--text-faint);
  margin-left: 16rpx;
  flex-shrink: 0;
}

.sta__bottom {
  height: 40rpx;
}

/* ================= 预算空态 ================= */
/* 预算空态卡：标题沿用 .chart__title 左对齐，内部交给 empty-state 居中 */
.bcal-empty {
  padding-bottom: 20rpx;
}
.bcal-empty empty-state {
  display: block;
  width: 100%;
}

/* ================= 预算日历地图 ================= */
.bcal__heads {
  display: flex;
  margin-top: 16rpx;
}
.bcal__head {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  color: var(--text-faint);
}
.bcal__weeks {
  margin-top: 6rpx;
}
.bcal__week {
  display: flex;
}
.bcal__cell {
  flex: 1;
  min-width: 0;
  height: 82rpx;
  margin: 5rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}
.bcal__num {
  font-size: 24rpx;
  color: var(--text-body);
  font-variant-numeric: tabular-nums;
}

/* 非本月 / 未来 / 无预算：灰 */
.bcal__cell--outm .bcal__num { color: var(--text-faint); opacity: 0.55; }
.bcal__cell--future .bcal__num,
.bcal__cell--no-budget .bcal__num { color: var(--text-faint); }

/* 盈余：两档深浅绿（状态色走 token） */
.bcal__cell--surplus.bcal__lv1 { background: var(--cal-surplus-lv1-bg); }
.bcal__cell--surplus.bcal__lv1 .bcal__num { color: var(--cal-surplus-lv1-num); }
.bcal__cell--surplus.bcal__lv2 { background: var(--cal-surplus-lv2-bg); }
.bcal__cell--surplus.bcal__lv2 .bcal__num { color: var(--cal-surplus-lv2-num); }

/* 超支：两档深浅红（状态色走 token） */
.bcal__cell--over.bcal__lv1 { background: var(--cal-over-lv1-bg); }
.bcal__cell--over.bcal__lv1 .bcal__num { color: var(--cal-over-lv1-num); }
.bcal__cell--over.bcal__lv2 { background: var(--cal-over-lv2-bg); }
.bcal__cell--over.bcal__lv2 .bcal__num { color: var(--cal-over-lv2-num); }

/* 今天：紫色描边（与背景共存） */
.bcal__cell--today {
  border: 2rpx solid var(--primary);
}

/* ================= 预算图例（一行） ================= */
.blegend {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-top: 14rpx;
  padding: 0 2rpx;
}
.blegend__item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 20rpx;
  color: var(--text-faint);
}
.blegend__dot {
  width: 15rpx;
  height: 15rpx;
  border-radius: 50%;
  box-sizing: border-box;
}
.blegend__dot--surplus { background: var(--budget-surplus); }
.blegend__dot--over { background: var(--budget-over); }
.blegend__dot--none { background: transparent; border: 1rpx solid var(--text-faint); }
.blegend__dot--today { background: transparent; border: 2rpx solid var(--primary); border-radius: 4rpx; }

/* ================= 预算节奏摘要 ================= */
.pace {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--divider);
}
.pace__item {
  width: 50%;
  display: flex;
  flex-direction: column;
  padding: 10rpx 6rpx;
  box-sizing: border-box;
}
.pace__label {
  font-size: 22rpx;
  color: var(--text-faint);
}
.pace__val {
  margin-top: 6rpx;
  font-size: 27rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}
.pace__val--none {
  color: var(--text-faint);
}

/* ================= 自定义日期统计 ================= */
.cr-pickers {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}
.cr-picker {
  flex: 1;
  min-width: 0;
}
.cr-picker__box {
  display: flex;
  flex-direction: column;
  padding: 16rpx 20rpx;
  border-radius: 18rpx;
  background: var(--glass-input);
  border: 1rpx solid var(--glass-input-border);
}
.cr-picker__label {
  font-size: 21rpx;
  color: var(--text-faint);
}
.cr-picker__value {
  margin-top: 6rpx;
  font-size: 27rpx;
  font-weight: 600;
  color: var(--text-primary);
  font-variant-numeric: tabular-nums;
}
.cr-sep {
  margin: 0 14rpx;
  font-size: 24rpx;
  color: var(--text-faint);
}
.cr-invalid {
  margin-top: 16rpx;
  padding: 14rpx 18rpx;
  border-radius: 14rpx;
  background: var(--danger-tint, rgba(255, 107, 107, 0.14));
}
.cr-invalid__text {
  font-size: 24rpx;
  color: var(--danger, #ff6b6b);
}
.cr-stats {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--divider);
}
.cr-stat {
  width: 50%;
  display: flex;
  flex-direction: column;
  padding: 10rpx 6rpx;
  box-sizing: border-box;
}
.cr-stat__label {
  font-size: 22rpx;
  color: var(--text-faint);
}
.cr-stat__value {
  margin-top: 6rpx;
  font-size: 27rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}

/* ================= 模块管理（Gate 3） ================= */
/* 顶部一行：分段控件 + 管理按钮 */
.seg-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin: 8rpx 0 20rpx;
}
.seg-row .seg {
  flex: 1;
  margin: 0;
}
.manage-btn {
  margin-left: 16rpx;
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  background: var(--surface);
}
.manage-btn:active {
  opacity: 0.6;
}
.manage-btn__text {
  font-size: 26rpx;
  color: var(--text-secondary);
  white-space: nowrap;
}

/* Bottom Sheet 内模块行 */
.mgr-list {
  margin-top: 8rpx;
}
.mgr-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 4rpx;
}
.mgr-row__label {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: var(--text-primary);
}
.mgr-row__switch {
  flex-shrink: 0;
  transform: scale(0.9);
}

/* 恢复默认按钮 */
.mgr-reset {
  margin-top: 16rpx;
  padding: 22rpx 0;
  border-radius: 18rpx;
  background: var(--glass-input);
  border: 1rpx solid var(--glass-input-border);
  text-align: center;
}
.mgr-reset:active {
  opacity: 0.6;
}
.mgr-reset__text {
  font-size: 28rpx;
  color: var(--primary-text);
  font-weight: 600;
}
