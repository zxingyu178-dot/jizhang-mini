.panel-scroll {
  height: 100%;
}
.sta {
  padding: 12rpx 28rpx 48rpx;
}

/* ---- 月度 / 年度 分段控件 ---- */
.seg {
  display: flex;
  flex-direction: row;
  background: rgba(255, 255, 255, 0.06);
  border-radius: 999rpx;
  padding: 6rpx;
  margin: 8rpx 0 20rpx;
}
.seg__item {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-secondary);
  padding: 12rpx 0;
  border-radius: 999rpx;
  transition: all 0.18s;
}
.seg__item--active {
  color: #fff;
  font-weight: 600;
  background: linear-gradient(135deg, var(--primary), var(--primary-deep));
  box-shadow: 0 6rpx 18rpx var(--primary-glow);
}

/* ---- 月份 / 年份 切换 ---- */
.month-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 8rpx 0 20rpx;
}
.month-title__text {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-primary);
}
.month-arrow {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  color: var(--text-secondary);
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.06);
}
.month-arrow--disabled {
  opacity: 0.3;
}

/* ---- Hero 主卡 ---- */
.hero {
  padding: 32rpx;
  margin-bottom: 28rpx;
}
.hero__label {
  font-size: 24rpx;
  color: var(--text-secondary);
}
.hero__big {
  display: block;
  font-size: 72rpx;
  font-weight: 800;
  margin: 12rpx 0 24rpx;
  letter-spacing: 1rpx;
}
.hero__foot {
  display: flex;
  flex-direction: row;
  padding-top: 22rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.07);
}
.hero__half {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.hero__sub-label {
  font-size: 22rpx;
  color: var(--text-faint);
}
.hero__sub {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-top: 6rpx;
}

/* ---- 图表卡 ---- */
.chart {
  padding: 28rpx;
  margin-bottom: 28rpx;
}
.chart__title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 24rpx;
}
.chart__empty {
  font-size: 24rpx;
  color: var(--text-faint);
  padding: 24rpx 0;
  text-align: center;
}

/* ---- 柱状图（纯 WXSS） ---- */
.chart__bars {
  display: flex;
  flex-direction: row;
  align-items: stretch;
}
.chart__bars--daily {
  height: 220rpx;
}
.chart__bars--month {
  height: 240rpx;
}
.bar-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  align-items: center;
  min-width: 0;
}
.bar {
  width: 60%;
  border-radius: 8rpx 8rpx 0 0;
  background: rgba(255, 255, 0.12);
}
.bar--exp {
  background: linear-gradient(180deg, var(--primary) 0%, var(--primary-deep) 100%);
  box-shadow: 0 0 12rpx var(--primary-glow);
}
.bar-label {
  width: 60rpx;
  flex-shrink: 0;
  white-space: nowrap;
  height: 34rpx;
  line-height: 34rpx;
  font-size: 18rpx;
  color: var(--text-faint);
  text-align: center;
}
.bar-label--hide {
  opacity: 0;
}

/* ---- 分类排行 ---- */
.rank-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 18rpx 0;
}
.rank-emoji {
  font-size: 36rpx;
  width: 56rpx;
}
.rank-main {
  flex: 1;
  min-width: 0;
  margin: 0 16rpx;
}
.rank-line {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 10rpx;
}
.rank-name {
  font-size: 26rpx;
  color: var(--text-primary);
}
.rank-amount {
  font-size: 26rpx;
  font-weight: 600;
}
.rank-bar {
  height: 10rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.08);
  overflow: hidden;
}
.rank-bar__fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, var(--primary), var(--primary-deep));
}
.rank-percent {
  width: 64rpx;
  text-align: right;
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* ---- 收入 / 支出对比 ---- */
.cmp-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 12rpx 0;
}
.cmp-label {
  width: 72rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}
.cmp-track {
  flex: 1;
  height: 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.07);
  overflow: hidden;
  margin: 0 16rpx;
}
.cmp-fill {
  height: 100%;
  border-radius: 999rpx;
}
.cmp-fill--exp {
  background: var(--expense);
}
.cmp-fill--inc {
  background: var(--income);
}
.cmp-val {
  width: 140rpx;
  text-align: right;
  font-size: 24rpx;
  font-weight: 600;
}

/* ---- 极值 ---- */
.ext-row {
  display: flex;
  flex-direction: row;
}
.ext-half {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.ext-label {
  font-size: 22rpx;
  color: var(--text-faint);
}
.ext-val {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-top: 8rpx;
}

.sta__bottom {
  height: 40rpx;
}

/* ================= 预算日历地图 ================= */
.bcal__heads {
  display: flex;
  margin-top: 16rpx;
}
.bcal__head {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.45);
}
.bcal__weeks {
  margin-top: 6rpx;
}
.bcal__week {
  display: flex;
}
.bcal__cell {
  flex: 1;
  min-width: 0;
  height: 82rpx;
  margin: 5rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}
.bcal__num {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  font-variant-numeric: tabular-nums;
}

/* 非本月 / 未来 / 无预算：灰 */
.bcal__cell--outm .bcal__num { color: rgba(255, 255, 255, 0.2); }
.bcal__cell--future .bcal__num,
.bcal__cell--no-budget .bcal__num { color: rgba(255, 255, 255, 0.38); }

/* 盈余：两档深浅绿 */
.bcal__cell--surplus.bcal__lv1 { background: rgba(56, 200, 150, 0.16); }
.bcal__cell--surplus.bcal__lv1 .bcal__num { color: #5fd6ab; }
.bcal__cell--surplus.bcal__lv2 { background: rgba(56, 200, 150, 0.3); }
.bcal__cell--surplus.bcal__lv2 .bcal__num { color: #8fe7c6; }

/* 超支：两档深浅红 */
.bcal__cell--over.bcal__lv1 { background: rgba(239, 96, 107, 0.16); }
.bcal__cell--over.bcal__lv1 .bcal__num { color: #f5838b; }
.bcal__cell--over.bcal__lv2 { background: rgba(239, 96, 107, 0.32); }
.bcal__cell--over.bcal__lv2 .bcal__num { color: #f89aa0; }

/* 今天：紫色描边（与背景共存） */
.bcal__cell--today {
  border: 2rpx solid #7c86ff;
}

/* ================= 预算图例（一行） ================= */
.blegend {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-top: 14rpx;
  padding: 0 2rpx;
}
.blegend__item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.5);
}
.blegend__dot {
  width: 15rpx;
  height: 15rpx;
  border-radius: 50%;
  box-sizing: border-box;
}
.blegend__dot--surplus { background: var(--budget-surplus); }
.blegend__dot--over { background: var(--budget-over); }
.blegend__dot--none { background: transparent; border: 1rpx solid rgba(255, 255, 255, 0.4); }
.blegend__dot--today { background: transparent; border: 2rpx solid #7c86ff; border-radius: 4rpx; }

/* ================= 预算节奏摘要 ================= */
.pace {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.08);
}
.pace__item {
  width: 50%;
  display: flex;
  flex-direction: column;
  padding: 10rpx 6rpx;
  box-sizing: border-box;
}
.pace__label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.5);
}
.pace__val {
  margin-top: 6rpx;
  font-size: 27rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}
.pace__val--none {
  color: rgba(255, 255, 255, 0.3);
}
