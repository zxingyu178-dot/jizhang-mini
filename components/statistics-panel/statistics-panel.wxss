/* flex 列布局：外层包裹 view 撑满 swiper-item，内层 scroll-view 用 flex:1 + min-height:0
   才能在 Skyline 下正确识别内容溢出并滚动（直接让 scroll-view height:100% 会导致
   scrollHeight 被算成 clientHeight，长页面无法滚动）。 */
.sta-wrap {
  height: 100%;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}
.panel-scroll {
  flex: 1;
  min-height: 0;
  width: 100%;
}
.sta {
  padding: 12rpx 28rpx 48rpx;
}

/* ---- 月度 / 年度 分段控件 ---- */
.seg {
  display: flex;
  flex-direction: row;
  background: var(--surface);
  border-radius: 999rpx;
  padding: 6rpx;
  margin: 8rpx 0 20rpx;
}
.seg__item {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-secondary);
  padding: 12rpx 0;
  border-radius: 999rpx;
  transition: all 0.18s;
}
.seg__item--active {
  color: var(--button-primary-text);
  font-weight: 600;
  background: linear-gradient(135deg, var(--primary), var(--primary-deep));
  box-shadow: 0 6rpx 18rpx var(--primary-glow);
}

/* ---- 月份 / 年份 切换 ---- */
.month-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 8rpx 0 20rpx;
}
.month-title__text {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-primary);
}
.month-arrow {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  color: var(--text-secondary);
  border-radius: 50%;
  background: var(--surface);
}
.month-arrow--disabled {
  opacity: 0.3;
}

/* ---- Hero 主卡 ---- */
.hero {
  padding: 32rpx;
  margin-bottom: 28rpx;
}
.hero__label {
  font-size: 24rpx;
  color: var(--text-secondary);
}
.hero__big {
  display: block;
  font-size: 72rpx;
  font-weight: 800;
  margin: 12rpx 0 24rpx;
  letter-spacing: 1rpx;
}
.hero__foot {
  display: flex;
  flex-direction: row;
  padding-top: 22rpx;
  border-top: 1rpx solid var(--divider);
}
.hero__half {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.hero__sub-label {
  font-size: 22rpx;
  color: var(--text-faint);
}
.hero__sub {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-top: 6rpx;
}
/* Hero 第二行：记录 / 最高消费日 / 日均（3 列，字号略小防溢出） */
.hero__foot--three {
  margin-top: 22rpx;
}
.hero__third {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
  padding-right: 10rpx;
}
.hero__third .hero__sub {
  font-size: 26rpx;
}

/* ---- 最大单笔支出卡（v1.3.0） ---- */
.largest {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 24rpx 28rpx;
  margin-bottom: 28rpx;
}
.largest__icon {
  width: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.largest__main {
  flex: 1;
  min-width: 0;
  margin: 0 16rpx;
  display: flex;
  flex-direction: column;
}
.largest__label {
  font-size: 24rpx;
  color: var(--text-secondary);
}
.largest__sub {
  font-size: 26rpx;
  color: var(--text-primary);
  margin-top: 6rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.largest__amount {
  font-size: 34rpx;
  font-weight: 700;
}

/* ---- 分类占比列表（v1.3.0） ---- */
.share-list {
  margin-top: 12rpx;
}
.share-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 12rpx 0;
}
.share-row__dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin-right: 12rpx;
  flex-shrink: 0;
}
.share-row--active {
  background: rgba(124, 134, 255, 0.12);
  border-radius: 12rpx;
}
.share-row__icon {
  width: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.share-row__name {
  flex: 1;
  min-width: 0;
  margin: 0 12rpx;
  font-size: 26rpx;
  color: var(--text-primary);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.share-row__amount {
  font-size: 26rpx;
  font-weight: 600;
}
.share-row__percent {
  width: 80rpx;
  text-align: right;
  font-size: 24rpx;
  color: var(--text-secondary);
}
/* 「其他」分组头：顶部分隔 + 名称加粗，与普通行区分 */
.share-row--group {
  border-top: 1rpx solid var(--divider);
  margin-top: 6rpx;
}
.share-row--group .share-row__name {
  font-weight: 700;
}
/* 被聚合子分类：缩进、字号弱化，视觉上从属于「其他」分组 */
.share-row--child {
  padding-left: 42rpx;
}
.share-row--child .share-row__name {
  font-size: 24rpx;
  color: var(--text-secondary);
}
/* 分组 / 子分类语义小标签 */
.share-row__tag {
  font-size: 20rpx;
  color: var(--text-faint);
  margin-right: 12rpx;
  flex-shrink: 0;
  white-space: nowrap;
}
.share-toggle {
  margin-top: 12rpx;
  padding: 12rpx 0;
  text-align: center;
}
.share-toggle__text {
  font-size: 24rpx;
  color: var(--primary);
}

/* ---- 图表卡 ---- */
.chart {
  padding: 28rpx;
  margin-bottom: 28rpx;
}
.chart__title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 24rpx;
}
.chart__empty {
  font-size: 24rpx;
  color: var(--text-faint);
  padding: 24rpx 0;
  text-align: center;
}

/* ---- 柱状图（纯 WXSS） ---- */
.chart__bars {
  display: flex;
  flex-direction: row;
  align-items: stretch;
}
.chart__bars--daily {
  height: 220rpx;
}
.chart__bars--month {
  height: 240rpx;
}
.bar-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  align-items: center;
  min-width: 0;
}
.bar-col--tap {
  /* 年度 12 月趋势可点：点击反馈 */
}
.bar-col--tap:active {
  opacity: 0.55;
}
.bar {
  width: 60%;
  border-radius: 8rpx 8rpx 0 0;
  background: var(--surface);
}
.bar--exp {
  background: linear-gradient(180deg, var(--primary) 0%, var(--primary-deep) 100%);
  box-shadow: 0 0 12rpx var(--primary-glow);
}
.bar-label {
  width: 60rpx;
  flex-shrink: 0;
  white-space: nowrap;
  height: 34rpx;
  line-height: 34rpx;
  font-size: 18rpx;
  color: var(--text-faint);
  text-align: center;
}
.bar-label--hide {
  opacity: 0;
}

/* ---- 分类排行 ---- */
.rank-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 18rpx 0;
}
.rank-emoji {
  font-size: 36rpx;
  width: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.rank-main {
  flex: 1;
  min-width: 0;
  margin: 0 16rpx;
}
.rank-line {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 10rpx;
}
.rank-name {
  font-size: 26rpx;
  color: var(--text-primary);
}
.rank-amount {
  font-size: 26rpx;
  font-weight: 600;
}
.rank-bar {
  height: 10rpx;
  border-radius: 999rpx;
  background: var(--surface);
  overflow: hidden;
}
.rank-bar__fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, var(--primary), var(--primary-deep));
}
.rank-percent {
  width: 64rpx;
  text-align: right;
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* ---- 收入 / 支出对比 ---- */
.cmp-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 12rpx 0;
}
.cmp-label {
  width: 72rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}
.cmp-track {
  flex: 1;
  height: 20rpx;
  border-radius: 999rpx;
  background: var(--surface);
  overflow: hidden;
  margin: 0 16rpx;
}
.cmp-fill {
  height: 100%;
  border-radius: 999rpx;
}
.cmp-fill--exp {
  background: var(--expense);
}
.cmp-fill--inc {
  background: var(--income);
}
.cmp-val {
  width: 140rpx;
  text-align: right;
  font-size: 24rpx;
  font-weight: 600;
}

/* ---- 极值 ---- */
.ext-row {
  display: flex;
  flex-direction: row;
}
.ext-half {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.ext-label {
  font-size: 22rpx;
  color: var(--text-faint);
}
.ext-val {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-top: 8rpx;
}

/* 年度回顾三项（Gate 5） */
.yr-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--divider);
}
.yr-row:last-child {
  border-bottom: none;
}
.yr-row:active {
  opacity: 0.6;
}
.yr-row__main {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.yr-row__label {
  font-size: 22rpx;
  color: var(--text-faint);
}
.yr-row__sub {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 8rpx;
  min-width: 0;
}
.yr-row__emoji {
  font-size: 26rpx;
  margin-right: 10rpx;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}
.yr-row__subtext {
  font-size: 27rpx;
  font-weight: 600;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.yr-row__val {
  font-size: 28rpx;
  font-weight: 700;
  margin-left: 16rpx;
  flex-shrink: 0;
}
.yr-row__arrow {
  font-size: 40rpx;
  color: var(--text-faint);
  margin-left: 16rpx;
  flex-shrink: 0;
}

.sta__bottom {
  height: 40rpx;
}

/* ================= 预算空态 ================= */
/* 预算空态卡：标题沿用 .chart__title 左对齐，内部交给 empty-state 居中 */
.bcal-empty {
  padding-bottom: 20rpx;
}
.bcal-empty empty-state {
  display: block;
  width: 100%;
}

/* ================= 预算日历地图 ================= */
.bcal__heads {
  display: flex;
  margin-top: 16rpx;
}
.bcal__head {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  color: var(--text-faint);
}
.bcal__weeks {
  margin-top: 6rpx;
}
.bcal__week {
  display: flex;
}
.bcal__cell {
  flex: 1;
  min-width: 0;
  height: 82rpx;
  margin: 5rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}
.bcal__num {
  font-size: 24rpx;
  color: var(--text-body);
  font-variant-numeric: tabular-nums;
}

/* 非本月 / 未来 / 无预算：灰 */
.bcal__cell--outm .bcal__num { color: var(--text-faint); opacity: 0.55; }
.bcal__cell--future .bcal__num,
.bcal__cell--no-budget .bcal__num { color: var(--text-faint); }

/* 盈余：两档深浅绿（状态色走 token） */
.bcal__cell--surplus.bcal__lv1 { background: var(--cal-surplus-lv1-bg); }
.bcal__cell--surplus.bcal__lv1 .bcal__num { color: var(--cal-surplus-lv1-num); }
.bcal__cell--surplus.bcal__lv2 { background: var(--cal-surplus-lv2-bg); }
.bcal__cell--surplus.bcal__lv2 .bcal__num { color: var(--cal-surplus-lv2-num); }

/* 超支：两档深浅红（状态色走 token） */
.bcal__cell--over.bcal__lv1 { background: var(--cal-over-lv1-bg); }
.bcal__cell--over.bcal__lv1 .bcal__num { color: var(--cal-over-lv1-num); }
.bcal__cell--over.bcal__lv2 { background: var(--cal-over-lv2-bg); }
.bcal__cell--over.bcal__lv2 .bcal__num { color: var(--cal-over-lv2-num); }

/* 今天：紫色描边（与背景共存） */
.bcal__cell--today {
  border: 2rpx solid var(--primary);
}

/* ================= 预算图例（一行） ================= */
.blegend {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-top: 14rpx;
  padding: 0 2rpx;
}
.blegend__item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 20rpx;
  color: var(--text-faint);
}
.blegend__dot {
  width: 15rpx;
  height: 15rpx;
  border-radius: 50%;
  box-sizing: border-box;
}
.blegend__dot--surplus { background: var(--budget-surplus); }
.blegend__dot--over { background: var(--budget-over); }
.blegend__dot--none { background: transparent; border: 1rpx solid var(--text-faint); }
.blegend__dot--today { background: transparent; border: 2rpx solid var(--primary); border-radius: 4rpx; }

/* ================= 预算节奏摘要 ================= */
.pace {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--divider);
}
.pace__item {
  width: 50%;
  display: flex;
  flex-direction: column;
  padding: 10rpx 6rpx;
  box-sizing: border-box;
}
.pace__label {
  font-size: 22rpx;
  color: var(--text-faint);
}
.pace__val {
  margin-top: 6rpx;
  font-size: 27rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}
.pace__val--none {
  color: var(--text-faint);
}

/* ================= 自定义日期统计 ================= */
.cr-pickers {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}
.cr-picker {
  flex: 1;
  min-width: 0;
}
.cr-picker__box {
  display: flex;
  flex-direction: column;
  padding: 16rpx 20rpx;
  border-radius: 18rpx;
  background: var(--glass-input);
  border: 1rpx solid var(--glass-input-border);
}
.cr-picker__label {
  font-size: 21rpx;
  color: var(--text-faint);
}
.cr-picker__value {
  margin-top: 6rpx;
  font-size: 27rpx;
  font-weight: 600;
  color: var(--text-primary);
  font-variant-numeric: tabular-nums;
}
.cr-sep {
  margin: 0 14rpx;
  font-size: 24rpx;
  color: var(--text-faint);
}
.cr-invalid {
  margin-top: 16rpx;
  padding: 14rpx 18rpx;
  border-radius: 14rpx;
  background: var(--danger-tint, rgba(255, 107, 107, 0.14));
}
.cr-invalid__text {
  font-size: 24rpx;
  color: var(--danger, #ff6b6b);
}
.cr-stats {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--divider);
}
.cr-stat {
  width: 50%;
  display: flex;
  flex-direction: column;
  padding: 10rpx 6rpx;
  box-sizing: border-box;
}
.cr-stat__label {
  font-size: 22rpx;
  color: var(--text-faint);
}
.cr-stat__value {
  margin-top: 6rpx;
  font-size: 27rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}

/* ================= 模块管理（Gate 3） ================= */
/* 顶部一行：分段控件 + 管理按钮 */
.seg-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin: 8rpx 0 20rpx;
}
.seg-row .seg {
  flex: 1;
  margin: 0;
}
.manage-btn {
  margin-left: 16rpx;
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  background: var(--surface);
}
.manage-btn:active {
  opacity: 0.6;
}
.manage-btn__text {
  font-size: 26rpx;
  color: var(--text-secondary);
  white-space: nowrap;
}

/* Bottom Sheet 内模块行 */
.mgr-list {
  margin-top: 8rpx;
}
.mgr-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 4rpx;
}
.mgr-row__label {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: var(--text-primary);
}
.mgr-row__switch {
  flex-shrink: 0;
  transform: scale(0.9);
}

/* 恢复默认按钮 */
.mgr-reset {
  margin-top: 16rpx;
  padding: 22rpx 0;
  border-radius: 18rpx;
  background: var(--glass-input);
  border: 1rpx solid var(--glass-input-border);
  text-align: center;
}
.mgr-reset:active {
  opacity: 0.6;
}
.mgr-reset__text {
  font-size: 28rpx;
  color: var(--primary);
  font-weight: 600;
}
