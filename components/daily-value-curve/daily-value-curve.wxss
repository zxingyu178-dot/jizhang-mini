.curve-wrap {
  position: relative;
  width: 100%;
  box-sizing: border-box;
}
.curve-canvas {
  width: 100%;
  height: 380rpx;
  display: block;
}

/* 触摸轻提示 */
.curve-tip {
  position: absolute;
  width: 150px;
  box-sizing: border-box;
  padding: 10px 14px;
  border-radius: 14px;
  background: var(--overlay-bg);
  border: 1rpx solid var(--card-border-hi);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.4);
  display: flex;
  flex-direction: column;
  pointer-events: none;
}
.curve-tip__date {
  font-size: 21rpx;
  color: var(--text-secondary);
}
.curve-tip__days {
  margin-top: 2rpx;
  font-size: 21rpx;
  color: var(--text-faint);
}
.curve-tip__val {
  margin-top: 4rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--primary);
  font-variant-numeric: tabular-nums;
}
