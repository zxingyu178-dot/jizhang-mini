.br-page {
  position: relative;
  width: 100%;
  background: var(--bg);
}
.br-bg {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: var(--bg-gradient);
}
.br-bg__glow {
  position: absolute;
  top: -120rpx;
  left: -100rpx;
  width: 500rpx;
  height: 500rpx;
  border-radius: 50%;
  background: radial-gradient(circle, var(--hero-glow) 0%, transparent 70%);
}

/* Header 由全局 <page-header> 组件统一提供 */

/* 滚动区 */
.br-scroll {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
}

.sec-label {
  font-size: 24rpx;
  color: var(--text-faint);
  padding: 28rpx 32rpx 12rpx;
}
.sec {
  margin: 0 28rpx 8rpx;
  padding: 0 24rpx;
}

.br-action {
  display: flex;
  align-items: center;
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--divider);
}
.br-action__text {
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.br-action__name {
  font-size: 28rpx;
  color: var(--text-primary);
}
.br-action__sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--text-faint);
  line-height: 1.5;
}

.br-info {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
}
.br-info__label {
  font-size: 26rpx;
  color: var(--text-secondary);
}
.br-info__val {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.br-tip {
  padding: 24rpx 40rpx 60rpx;
}
.br-tip__text {
  font-size: 22rpx;
  line-height: 1.7;
  color: var(--text-faint);
}
