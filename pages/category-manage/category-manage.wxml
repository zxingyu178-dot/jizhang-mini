<view class="cm-page {{themeClass}}" style="height:{{windowHeight}}px;">
  <view class="cm-bg">
    <view class="cm-bg__glow"></view>
  </view>

  <!-- 统一二级页 Header -->
  <page-header title="分类管理"></page-header>

  <scroll-view scroll-y class="cm-scroll" style="top:{{headerHeight}}px;" enhanced show-scrollbar="{{false}}">
    <!-- 系统分类（只读） -->
    <view class="sec-label">系统分类</view>
    <view class="glass-card sec">
      <view class="cm-row" wx:for="{{system}}" wx:key="id">
        <view class="cm-row__icon">
          <category-icon icon-type="{{item.iconType}}" icon-value="{{item.iconValue}}" emoji="{{item.emoji}}" size="22"/>
        </view>
        <text class="cm-row__name">{{item.name}}</text>
      </view>
    </view>

    <!-- 我的分类（可编辑、归档） -->
    <view class="sec-label">我的分类</view>
    <view class="glass-card sec">
      <view class="cm-row" wx:for="{{custom}}" wx:key="id">
        <view class="cm-row__main" data-id="{{item.id}}" bindtap="onEdit">
          <view class="cm-row__icon">
            <category-icon icon-type="{{item.iconType}}" icon-value="{{item.iconValue}}" emoji="{{item.emoji}}" size="22"/>
          </view>
          <text class="cm-row__name">{{item.name}}</text>
        </view>
        <view class="cm-row__archive" data-id="{{item.id}}" bindtap="onArchive">归档</view>
      </view>
      <view class="cm-row cm-row--last" wx:if="{{!custom.length}}">
        <text class="cm-empty">还没有自定义分类</text>
      </view>
    </view>

    <!-- 添加分类 -->
    <view class="cm-add" bindtap="onAdd">
      <text class="cm-add__icon">+</text>
      <text class="cm-add__text">添加分类</text>
    </view>

    <!-- 已归档（可恢复） -->
    <block wx:if="{{archived.length}}">
      <view class="sec-label">已归档</view>
      <view class="glass-card sec">
        <view class="cm-row cm-row--last" wx:for="{{archived}}" wx:key="id">
          <view class="cm-row__main">
            <view class="cm-row__icon cm-row__icon--off">
              <category-icon icon-type="{{item.iconType}}" icon-value="{{item.iconValue}}" emoji="{{item.emoji}}" size="22"/>
            </view>
            <text class="cm-row__name cm-row__name--off">{{item.name}}</text>
          </view>
          <view class="cm-row__restore" data-id="{{item.id}}" bindtap="onRestore">恢复</view>
        </view>
      </view>
    </block>

    <view style="height:60rpx;"></view>
  </scroll-view>

  <!-- 分类编辑器 Sheet -->
  <bottom-sheet show="{{editorShow}}" title="{{editorTitle}}" bind:close="onEditorClose">
    <view class="ce">
      <!-- 图标库 / Emoji 两个 Tab -->
      <view class="ce__tabs">
        <view class="ce__tab {{editorTab==='builtin'?'ce__tab--on':''}}" data-tab="builtin" bindtap="onEditorTab">图标库</view>
        <view class="ce__tab {{editorTab==='emoji'?'ce__tab--on':''}}" data-tab="emoji" bindtap="onEditorTab">Emoji</view>
      </view>

      <!-- 图标库：49 个本地 SVG 网格，当前选中高亮 -->
      <scroll-view wx:if="{{editorTab==='builtin'}}" scroll-y class="ce__grid-scroll" enhanced show-scrollbar="{{false}}">
        <view class="ce__grid">
          <view wx:for="{{iconList}}" wx:key="id"
            class="ce__cell {{iconType==='builtin'&&iconValue===item.id?'ce__cell--on':''}}"
            data-id="{{item.id}}" bindtap="onPickBuiltin">
            <category-icon icon-type="builtin" icon-value="{{item.id}}" size="24"/>
          </view>
        </view>
      </scroll-view>

      <!-- Emoji：自定义输入 + 预览 -->
      <view wx:else class="ce__emoji-wrap">
        <input class="ce__emoji-input" type="text" placeholder="输入一个 Emoji"
          placeholder-class="ce-ph" value="{{iconType==='emoji'?iconValue:''}}"
          bindinput="onEmoji" maxlength="4"/>
        <view class="ce__emoji-preview" wx:if="{{iconType==='emoji'&&iconValue}}">
          <category-icon icon-type="emoji" icon-value="{{iconValue}}" size="30"/>
        </view>
      </view>

      <!-- 名称 -->
      <view class="ce__field">
        <text class="ce__label">名称</text>
        <input class="ce__name" type="text" placeholder="分类名称，1-8 个字"
          placeholder-class="ce-ph" value="{{name}}" bindinput="onName" maxlength="8"/>
      </view>

      <view class="ce__save {{canSave?'':'ce__save--disabled'}}" bindtap="onSaveEditor">保存</view>
    </view>
  </bottom-sheet>
</view>
