.cm-page {
  position: relative;
  width: 100%;
  background: var(--bg);
}
.cm-bg {
  position: absolute;
  left: 0; right: 0; top: 0; bottom: 0;
  background: var(--bg-gradient);
}
.cm-bg__glow {
  position: absolute;
  top: -120rpx;
  left: -100rpx;
  width: 500rpx;
  height: 500rpx;
  border-radius: 50%;
  background: radial-gradient(circle, var(--hero-glow) 0%, transparent 70%);
}

/* Header 由全局 <page-header> 组件统一提供 */

/* 滚动区 */
.cm-scroll {
  position: absolute;
  left: 0; right: 0; bottom: 0;
}

.sec-label {
  font-size: 24rpx;
  color: var(--text-faint);
  padding: 28rpx 32rpx 12rpx;
}
.sec {
  margin: 0 28rpx 8rpx;
  padding: 0 24rpx;
}

/* 分类行 */
.cm-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--divider);
}
.cm-row--last {
  border-bottom: none;
}
.cm-row__main {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}
.cm-row__icon {
  width: 44rpx;
  margin-right: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.cm-row__icon--off {
  opacity: 0.4;
}
.cm-row__name {
  font-size: 28rpx;
  color: var(--text-primary);
}
.cm-row__name--off {
  color: var(--text-faint);
}
.cm-row__archive,
.cm-row__restore {
  font-size: 24rpx;
  color: var(--text-secondary);
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: var(--glass-input);
}
.cm-row__restore {
  color: var(--primary);
}
.cm-empty {
  font-size: 26rpx;
  color: var(--text-faint);
  padding: 8rpx 0;
}

/* 添加分类 */
.cm-add {
  margin: 16rpx 28rpx 8rpx;
  height: 92rpx;
  border-radius: 20rpx;
  border: 1rpx dashed var(--card-border-hi);
  display: flex;
  align-items: center;
  justify-content: center;
}
.cm-add__icon {
  font-size: 34rpx;
  color: var(--text-secondary);
  margin-right: 10rpx;
}
.cm-add__text {
  font-size: 27rpx;
  color: var(--text-secondary);
}

/* 编辑器 */
.ce__tabs {
  display: flex;
  gap: 12rpx;
  padding: 8rpx 0 20rpx;
}
.ce__tab {
  flex: 1;
  height: 64rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 27rpx;
  color: var(--text-secondary);
  background: var(--glass-input);
}
.ce__tab--on {
  color: var(--button-primary-text);
  background: var(--button-primary);
  font-weight: 600;
}

/* 图标库网格 */
.ce__grid-scroll {
  height: 360rpx;
}
.ce__grid {
  display: flex;
  flex-wrap: wrap;
}
.ce__cell {
  width: 14.28%;
  height: 90rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  border: 2rpx solid transparent;
  box-sizing: border-box;
}
.ce__cell--on {
  background: var(--primary-tint);
  border-color: var(--primary);
}

/* Emoji 输入 */
.ce__emoji-wrap {
  height: 360rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
}
.ce__emoji-input {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  border-radius: 14rpx;
  background: var(--glass-input);
  font-size: 40rpx;
  color: var(--text-primary);
}
.ce__emoji-preview {
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ce__field {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  padding: 18rpx 8rpx;
  border-bottom: 1rpx solid var(--divider);
}
.ce__label {
  font-size: 28rpx;
  color: var(--text-secondary);
  width: 96rpx;
}
.ce__name {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 30rpx;
  color: var(--text-primary);
}
.ce__name--locked {
  opacity: 0.55;
}
.ce__lock-hint {
  flex-basis: 100%;
  font-size: 23rpx;
  color: var(--text-faint);
  padding: 4rpx 0 2rpx 96rpx;
}
.ce-ph {
  color: var(--text-faint);
  font-size: 28rpx;
}
.ce__save {
  margin: 28rpx 8rpx 40rpx;
  height: 92rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--button-primary);
  color: var(--button-primary-text);
  font-size: 29rpx;
  font-weight: 600;
  box-shadow: var(--button-primary-shadow);
}
.ce__save--disabled {
  background: var(--button-disabled);
  color: var(--button-disabled-text);
}
