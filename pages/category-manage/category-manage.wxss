.cm-page {
  position: relative;
  width: 100%;
}
.cm-bg {
  position: absolute;
  left: 0; right: 0; top: 0; bottom: 0;
  background: linear-gradient(180deg, #0a0f1e 0%, #05060a 100%);
}
.cm-bg__glow {
  position: absolute;
  top: -120rpx;
  left: -100rpx;
  width: 500rpx;
  height: 500rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(124, 134, 255, 0.18) 0%, transparent 70%);
}

/* Header */
.cm-header {
  position: absolute;
  left: 0; right: 0; top: 0;
  display: flex;
  align-items: center;
  padding-left: 20rpx;
  z-index: 10;
  box-sizing: border-box;
}
.cm-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.cm-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-left: 8rpx;
}

/* 滚动区 */
.cm-scroll {
  position: absolute;
  left: 0; right: 0; bottom: 0;
}

.sec-label {
  font-size: 24rpx;
  color: var(--text-faint);
  padding: 28rpx 32rpx 12rpx;
}
.sec {
  margin: 0 28rpx 8rpx;
  padding: 0 24rpx;
}

/* 分类行 */
.cm-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}
.cm-row--last {
  border-bottom: none;
}
.cm-row__main {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}
.cm-row__emoji {
  font-size: 36rpx;
  margin-right: 18rpx;
}
.cm-row__emoji--off {
  opacity: 0.4;
}
.cm-row__name {
  font-size: 28rpx;
  color: var(--text-primary);
}
.cm-row__name--off {
  color: var(--text-faint);
}
.cm-row__archive,
.cm-row__restore {
  font-size: 24rpx;
  color: var(--text-secondary);
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.06);
}
.cm-row__restore {
  color: #aab2ff;
}
.cm-empty {
  font-size: 26rpx;
  color: var(--text-faint);
  padding: 8rpx 0;
}

/* 添加分类 */
.cm-add {
  margin: 16rpx 28rpx 8rpx;
  height: 92rpx;
  border-radius: 20rpx;
  border: 1rpx dashed rgba(255, 255, 255, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
}
.cm-add__icon {
  font-size: 34rpx;
  color: var(--text-secondary);
  margin-right: 10rpx;
}
.cm-add__text {
  font-size: 27rpx;
  color: var(--text-secondary);
}

/* 编辑器 */
.ce__field {
  display: flex;
  align-items: center;
  padding: 18rpx 8rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}
.ce__label {
  font-size: 28rpx;
  color: var(--text-secondary);
  width: 96rpx;
}
.ce__emoji {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  font-size: 40rpx;
  color: #fff;
}
.ce__name {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 30rpx;
  color: #fff;
}
.ce-ph {
  color: rgba(255, 255, 255, 0.3);
  font-size: 28rpx;
}
.ce__save {
  margin: 28rpx 8rpx 40rpx;
  height: 92rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(124, 134, 255, 0.85);
  color: #fff;
  font-size: 29rpx;
  font-weight: 600;
}
.ce__save--disabled {
  background: rgba(255, 255, 255, 0.1);
  color: rgba(255, 255, 255, 0.4);
}
