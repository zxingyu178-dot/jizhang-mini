/* pages/add/add.wxss */
.type-switch {
  display: flex;
  background: #ffffff;
  border-radius: 48rpx;
  padding: 6rpx;
  margin-bottom: 24rpx;
}

.type-item {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 48rpx;
  font-size: 30rpx;
  color: #8a8f99;
}

.type-item.active.expense {
  background: #fa5151;
  color: #ffffff;
}

.type-item.active.income {
  background: #07c160;
  color: #ffffff;
}

.amount-card {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.amount-symbol {
  font-size: 48rpx;
  font-weight: 600;
  margin-right: 16rpx;
}

.amount-input {
  flex: 1;
  font-size: 64rpx;
  font-weight: 600;
}

.amount-placeholder {
  color: #c8c9cc;
  font-weight: 400;
}

.section-title {
  font-size: 28rpx;
  color: #8a8f99;
  margin-bottom: 20rpx;
}

.category-grid {
  display: flex;
  flex-wrap: wrap;
}

.category-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0;
}

.category-emoji {
  width: 88rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 44rpx;
  background: #f5f6f8;
  border-radius: 50%;
}

.category-label {
  font-size: 24rpx;
  margin-top: 10rpx;
  color: #5a6068;
}

.category-item.active.expense .category-emoji {
  background: rgba(250, 81, 81, 0.12);
}

.category-item.active.expense .category-label {
  color: #fa5151;
  font-weight: 600;
}

.category-item.active.income .category-emoji {
  background: rgba(7, 193, 96, 0.12);
}

.category-item.active.income .category-label {
  color: #07c160;
  font-weight: 600;
}

.form-card {
  padding: 0 28rpx;
  margin-bottom: 32rpx;
}

.form-row {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f0f1f3;
}

.form-row:last-child {
  border-bottom: none;
}

.form-label {
  width: 120rpx;
  color: #5a6068;
}

.form-value {
  flex: 1;
  text-align: right;
}

.form-input {
  flex: 1;
  text-align: right;
}

.form-placeholder {
  color: #c8c9cc;
}

.save-btn {
  margin-top: 8rpx;
}
