.search-page {
  position: relative;
  width: 100%;
  background: var(--bg);
}
.search-bg {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: var(--bg-gradient);
}
.search-bg__glow {
  position: absolute;
  top: -120rpx;
  right: -100rpx;
  width: 500rpx;
  height: 500rpx;
  border-radius: 50%;
  background: radial-gradient(circle, var(--hero-glow) 0%, transparent 70%);
}

/* Header 由全局 <page-header> 提供，搜索框置于其默认 slot */
.s-input {
  flex: 1;
  width: 100%;
  display: flex;
  align-items: center;
  height: 72rpx;
  background: var(--glass-input);
  border: 1rpx solid var(--glass-input-border);
  border-radius: 36rpx;
  padding: 0 24rpx;
}
.s-input__icon {
  display: flex;
  align-items: center;
  margin-right: 12rpx;
}
.s-input__field {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-primary);
  min-width: 0;
}
.s-input__ph {
  color: var(--text-faint);
}
.s-input__clear {
  display: flex;
  align-items: center;
  padding-left: 12rpx;
}

/* 结果 */
.s-results {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
}
/* 空态（empty-state 组件）顶部留白 */
.s-search-empty {
  display: block;
  width: 100%;
  box-sizing: border-box;
  padding-top: 120rpx;
}

.day-head {
  display: flex;
  align-items: center;
  padding: 8rpx 32rpx 12rpx;
}
.day-head__label {
  font-size: 24rpx;
  color: var(--text-secondary);
}
.day-card {
  margin: 0 28rpx 20rpx;
  overflow: hidden;
}
.bill-item {
  display: flex;
  align-items: center;
  padding: 22rpx 24rpx;
  border-bottom: 1rpx solid var(--divider);
}
.bill-item:last-child {
  border-bottom: none;
}
.bill-item__emoji {
  font-size: 40rpx;
  width: 64rpx;
}
.bill-item__main {
  flex: 1;
  display: flex;
  flex-direction: column;
  margin: 0 16rpx;
}
.bill-item__name {
  font-size: 28rpx;
  color: var(--text-primary);
}
.bill-item__note {
  font-size: 22rpx;
  color: var(--text-faint);
  margin-top: 4rpx;
}
.bill-item__amount {
  font-size: 28rpx;
  font-weight: 600;
}
