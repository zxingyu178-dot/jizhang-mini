.search-page {
  position: relative;
  width: 100%;
}
.search-bg {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: linear-gradient(180deg, #0a0f1e 0%, #05060a 100%);
}
.search-bg__glow {
  position: absolute;
  top: -120rpx;
  right: -100rpx;
  width: 500rpx;
  height: 500rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(124, 134, 255, 0.18) 0%, transparent 70%);
}

/* Header */
.s-header {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  display: flex;
  align-items: center;
  padding-left: 20rpx;
  padding-right: 28rpx;
  z-index: 10;
}
.s-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  color: var(--text-primary);
}
.s-input {
  flex: 1;
  display: flex;
  align-items: center;
  height: 72rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 36rpx;
  padding: 0 24rpx;
  margin-left: 8rpx;
}
.s-input__icon {
  font-size: 26rpx;
  margin-right: 12rpx;
}
.s-input__field {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-primary);
  min-width: 0;
}
.s-input__ph {
  color: rgba(255, 255, 255, 0.3);
}
.s-input__clear {
  font-size: 24rpx;
  color: var(--text-faint);
  padding-left: 12rpx;
}

/* 结果 */
.s-results {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
}
.s-hint {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 40rpx;
}
.s-hint__emoji {
  font-size: 72rpx;
  margin-bottom: 24rpx;
}
.s-hint__text {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.day-head {
  display: flex;
  align-items: center;
  padding: 8rpx 32rpx 12rpx;
}
.day-head__label {
  font-size: 24rpx;
  color: var(--text-secondary);
}
.day-card {
  margin: 0 28rpx 20rpx;
  overflow: hidden;
}
.bill-item {
  display: flex;
  align-items: center;
  padding: 22rpx 24rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}
.bill-item:last-child {
  border-bottom: none;
}
.bill-item__emoji {
  font-size: 40rpx;
  width: 64rpx;
}
.bill-item__main {
  flex: 1;
  display: flex;
  flex-direction: column;
  margin: 0 16rpx;
}
.bill-item__name {
  font-size: 28rpx;
  color: var(--text-primary);
}
.bill-item__note {
  font-size: 22rpx;
  color: var(--text-faint);
  margin-top: 4rpx;
}
.bill-item__amount {
  font-size: 28rpx;
  font-weight: 600;
}
