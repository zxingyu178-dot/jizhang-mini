<view class="bs2-page" style="height:{{windowHeight}}px;">
  <view class="bs2-bg">
    <view class="bs2-bg__glow"></view>
  </view>

  <!-- Header -->
  <view class="bs2-header" style="padding-top:{{statusBarHeight}}px;height:{{headerHeight}}px;">
    <view class="bs2-back" bindtap="onBack">
      <dv-icon name="chevronLeft" size="24" color="rgba(255,255,255,0.78)"></dv-icon>
    </view>
    <text class="bs2-title">预算设置</text>
  </view>

  <scroll-view scroll-y class="bs2-scroll" style="top:{{headerHeight}}px;" enhanced show-scrollbar="{{false}}">
    <!-- 启用预算 -->
    <view class="glass-card sec">
      <view class="bs2-row">
        <text class="bs2-row__label">启用预算</text>
        <switch checked="{{enabled}}" bindchange="onToggleEnabled" color="#7c86ff"/>
      </view>
    </view>

    <!-- 金额 / 生效日（启用时） -->
    <block wx:if="{{enabled}}">
      <view class="glass-card sec">
        <view class="bs2-amount">
          <text class="bs2-amount__cur">¥</text>
          <input class="bs2-amount__input" type="digit" placeholder="0.00" placeholder-class="bs2-ph" value="{{amountText}}" bindinput="onAmount"/>
          <text class="bs2-amount__unit">/ 天</text>
        </view>
      </view>

      <view class="glass-card sec">
        <picker mode="date" value="{{effectiveDate}}" end="{{todayStr}}" bindchange="onDate">
          <view class="bs2-row">
            <text class="bs2-row__label">生效日期</text>
            <text class="bs2-row__val">{{effectiveDate}} ›</text>
          </view>
        </picker>
      </view>
    </block>

    <view class="bs2-note">
      <text class="bs2-note__text">修改预算只影响生效日期之后，之前的预算记录不会改变。生效日期可选过去，不能选未来。</text>
    </view>

    <view class="bs2-save {{canSave?'':'bs2-save--disabled'}}" bindtap="onSave">保存</view>
  </scroll-view>
</view>
