.bs2-page {
  position: relative;
  width: 100%;
  background: var(--bg);
}
.bs2-bg {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: var(--bg-gradient);
}
.bs2-bg__glow {
  position: absolute;
  top: -120rpx;
  left: -100rpx;
  width: 500rpx;
  height: 500rpx;
  border-radius: 50%;
  background: radial-gradient(circle, var(--hero-glow) 0%, transparent 70%);
}

/* Header 由全局 <page-header> 组件统一提供 */

/* 滚动区 */
.bs2-scroll {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
}

.sec {
  margin: 0 28rpx 8rpx;
  padding: 0 24rpx;
}
.sec-label {
  font-size: 24rpx;
  color: var(--text-faint);
  padding: 28rpx 32rpx 12rpx;
}
.bs2-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 0;
}
.bs2-row__label {
  font-size: 28rpx;
  color: var(--text-primary);
}
.bs2-row__val {
  font-size: 26rpx;
  color: var(--text-secondary);
}

/* 金额输入 */
.bs2-amount {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
}
.bs2-amount__cur {
  flex-shrink: 0;
  font-size: 40rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-right: 10rpx;
}
/* 预算金额：保留原有 80rpx / 52rpx 大字号，仅显式 border-box + padding，防裁切。 */
.bs2-amount__input {
  flex: 1;
  min-width: 0;
  height: 80rpx;
  line-height: 80rpx;
  padding: 0;
  box-sizing: border-box;
  font-size: 52rpx;
  font-weight: 700;
  color: var(--text-primary);
  font-variant-numeric: tabular-nums;
}
.bs2-amount__unit {
  flex-shrink: 0;
  margin-left: 10rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
}
.bs2-ph {
  color: var(--text-faint);
  font-weight: 600;
}
/* 数字键盘完成：位于「/ 天」右侧，88rpx 高度（约 44px 触控），保持金额列不挤压。 */
.bs2-amount__done {
  flex-shrink: 0;
  min-width: 96rpx;
  height: 88rpx;
  line-height: 88rpx;
  margin-left: 12rpx;
  padding: 0 18rpx;
  box-sizing: border-box;
  text-align: center;
  font-size: 24rpx;
  color: var(--text-secondary);
  background: var(--glass-input);
  border: 1rpx solid var(--glass-input-border);
  border-radius: 14rpx;
}
.bs2-amount__done--hover {
  background: var(--selected-bg);
  color: var(--text-primary);
}

/* 说明 */
.bs2-note {
  padding: 16rpx 40rpx 8rpx;
}
.bs2-note__text {
  font-size: 22rpx;
  line-height: 1.7;
  color: var(--text-faint);
}

/* 保存按钮 */
.bs2-save {
  margin: 24rpx 28rpx 60rpx;
  height: 92rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--button-primary);
  color: var(--button-primary-text);
  font-size: 29rpx;
  font-weight: 600;
  box-shadow: var(--button-primary-shadow);
}
.bs2-save--disabled {
  background: var(--button-disabled);
  color: var(--button-disabled-text);
}
