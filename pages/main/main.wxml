<view class="shell" style="height:{{windowHeight}}px;">
  <!-- 背景层：紫黑渐变 + 紫色柔光 -->
  <view class="shell-bg">
    <view class="shell-bg__glow shell-bg__glow--1"></view>
    <view class="shell-bg__glow shell-bg__glow--2"></view>
  </view>

  <!-- 自定义 Header -->
  <view class="header" style="padding-top:{{statusBarHeight}}px;height:{{headerHeight}}px;">
    <view class="header__bar" style="height:{{navBarHeight}}px;padding-right:{{menuPad}}px;">
      <text class="header__title">每日的价值</text>
      <view class="header__actions">
        <view class="glass-pill header__search" bindtap="onSearch">
          <dv-icon name="search" size="14" color="rgba(255,255,255,0.62)" class="header__search-icon" />
          <text class="header__search-text">搜索账单</text>
        </view>
        <view class="header__setting" bindtap="onSettings">
          <dv-icon name="settings" size="22" color="rgba(255,255,255,0.72)" />
        </view>
      </view>
    </view>
  </view>

  <!-- 顶部 Tabs：统计 / 记账 / 日价 -->
  <view class="tabs" style="top:{{headerHeight}}px;height:{{tabsHeight}}px;">
    <view class="tabs__item {{current===0?'active':''}}" data-i="0" bindtap="onTab"><text>统计</text></view>
    <view class="tabs__item {{current===1?'active':''}}" data-i="1" bindtap="onTab"><text>记账</text></view>
    <view class="tabs__item {{current===2?'active':''}}" data-i="2" bindtap="onTab"><text>日价</text></view>
  </view>

  <!-- Swiper 三 Panel -->
  <swiper
    class="swiper"
    style="top:{{swiperTop}}px;height:{{swiperHeight}}px;"
    current="{{current}}"
    bindchange="onSwiperChange"
    duration="180"
    easing-function="easeOut"
  >
    <swiper-item>
      <statistics-panel id="statisticsPanel" bind:categorydetail="onShowCategoryDetail" bind:daydetail="onShowDayDetail" />
    </swiper-item>
    <swiper-item>
      <accounting-panel id="accountingPanel" bind:tapbill="onTapBill" />
    </swiper-item>
    <swiper-item>
      <daily-value-panel id="dailyValuePanel" />
    </swiper-item>
  </swiper>

  <!-- 玻璃 FAB（记账 Tab：记一笔；日价 Tab：添加日价物品；统计 Tab 无 FAB） -->
  <view class="fab-wrap" wx:if="{{current===1||current===2}}" style="bottom:{{safeBottom + 20}}px;" bindtap="onAdd">
    <text class="fab-icon">+</text>
  </view>

  <!-- 记账表单 Bottom Sheet（新增 / 编辑） -->
  <bottom-sheet show="{{sheetShow}}" title="{{sheetTitle}}" bind:close="onSheetClose">
    <bill-form id="billForm" bind:saved="onBillSaved" bind:deleted="onBillDeleted" />
  </bottom-sheet>

  <!-- 日价新增表单 Bottom Sheet（日价 Tab 的 FAB） -->
  <bottom-sheet show="{{dvSheetShow}}" title="{{dvSheetTitle}}" bind:close="onDvSheetClose">
    <daily-value-form id="dvForm" bind:saved="onDvSaved" />
  </bottom-sheet>

  <!-- 预算日详情弹层（页面级 fixed，只读） -->
  <bottom-sheet show="{{dayDetail.show}}" title="{{dayDetail.title}}" bind:close="onCloseDayDetail">
    <view class="dayd">
      <view class="dayd__rows">
        <!-- 无预算日：提示当日未启用预算，不显示预算 / 超支 -->
        <block wx:if="{{!dayDetail.hasBudget}}">
          <view class="dayd__notice">当日未启用预算</view>
          <view class="dayd__row">
            <text class="dayd__label">实际支出</text>
            <text class="dayd__val">{{dayDetail.actualText}}</text>
          </view>
        </block>
        <!-- 有预算日：预算 / 实际 / 盈余·超支 -->
        <block wx:else>
          <view class="dayd__row">
            <text class="dayd__label">预算</text>
            <text class="dayd__val">{{dayDetail.budgetText}}</text>
          </view>
          <view class="dayd__row">
            <text class="dayd__label">实际支出</text>
            <text class="dayd__val">{{dayDetail.actualText}}</text>
          </view>
          <view class="dayd__row">
            <text class="dayd__label">{{dayDetail.deltaLabel}}</text>
            <text class="dayd__val {{dayDetail.delta>=0?'budget-surplus':'budget-over'}}">{{dayDetail.deltaText}}</text>
          </view>
        </block>
      </view>

      <view class="dayd__cathead" wx:if="{{dayDetail.categories.length}}">分类</view>
      <view class="dayd__cat" wx:for="{{dayDetail.categories}}" wx:key="categoryId">
        <text class="dayd__cat-emoji">{{item.emoji}}</text>
        <text class="dayd__cat-name">{{item.name}}</text>
        <text class="dayd__cat-cents">{{item.centsText}}</text>
      </view>

      <view class="dayd__cathead" wx:if="{{dayDetail.bills.length}}">当天账单</view>
      <view class="dayd__bill" wx:for="{{dayDetail.bills}}" wx:key="id">
        <text class="dayd__bill-name">{{item.name}}</text>
        <text class="dayd__bill-amount">{{item.amountText}}</text>
      </view>
      <view class="dayd__empty" wx:if="{{!dayDetail.billCount}}">当天没有普通支出账单</view>
    </view>
  </bottom-sheet>

  <!-- 分类明细弹层（页面级 fixed，相对视口定位） -->
  <view class="cat-mask {{catDetail.show?'cat-mask--show':''}}" wx:if="{{catDetail.show}}" bindtap="onCloseCat">
    <view class="cat-sheet" catchtap="noop">
      <view class="cat-sheet__head">
        <text class="cat-sheet__title">{{catDetail.title}}</text>
        <view class="cat-sheet__close" bindtap="onCloseCat">×</view>
      </view>
      <scroll-view scroll-y class="cat-sheet__scroll" style="padding-bottom:{{safeBottom}}px;">
        <view class="cat-item" wx:for="{{catDetail.items}}" wx:key="id">
          <text class="cat-item__date">{{item.date}}</text>
          <view class="cat-item__main">
            <text class="cat-item__note" wx:if="{{item.note}}">{{item.note}}</text>
          </view>
          <text class="cat-item__amount money-expense">{{item.amountText}}</text>
        </view>
        <view class="cat-empty" wx:if="{{!catDetail.items.length}}">该分类没有账单</view>
      </scroll-view>
    </view>
  </view>
</view>
