.shell {
  position: relative;
  width: 100%;
  overflow: hidden;
}

/* ---- 背景 ---- */
.shell-bg {
  position: absolute;
  inset: 0;
  z-index: 0;
  background: linear-gradient(180deg, #0c0e1a 0%, #05060a 100%);
}
.shell-bg__glow {
  position: absolute;
  border-radius: 50%;
}
.shell-bg__glow--1 {
  width: 460px;
  height: 460px;
  top: -140px;
  left: -120px;
  background: radial-gradient(circle, var(--glow-1), transparent 70%);
}
.shell-bg__glow--2 {
  width: 380px;
  height: 380px;
  bottom: -120px;
  right: -120px;
  background: radial-gradient(circle, var(--glow-2), transparent 70%);
}

/* ---- 自定义 Header ---- */
.header {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 20;
  box-sizing: border-box;
}
.header__bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
}
.header__title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
}
.header__actions {
  display: flex;
  align-items: center;
  flex: 1;
  justify-content: flex-end;
  margin-left: 20rpx;
  min-width: 0;
}
.header__search {
  flex: 1;
  height: 56rpx;
  padding: 0 20rpx;
  margin-right: 8rpx;
  max-width: 300rpx;
}
.header__search-icon {
  margin-right: 8rpx;
  display: flex;
  align-items: center;
}
.header__search-text {
  font-size: 24rpx;
}
.header__setting {
  width: 56rpx;
  height: 56rpx;
  margin-left: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ---- 顶部 Tabs ---- */
.tabs {
  position: absolute;
  left: 0;
  right: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: center;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}
.tabs__item {
  flex: 1;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.42);
  position: relative;
  transition: color 0.18s ease;
}
.tabs__item.active {
  color: #f2f3ff;
  font-weight: 600;
}
.tabs__item.active::after {
  content: '';
  position: absolute;
  bottom: 5rpx;
  width: 44rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: linear-gradient(90deg, var(--primary), var(--primary-deep));
  box-shadow: 0 0 10rpx var(--primary-glow);
}

/* ---- Swiper ---- */
.swiper {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
}

/* ---- 玻璃 FAB（大圆角方形，非圆形浮球；柔和紫光） ---- */
.fab-wrap {
  position: absolute;
  right: 36rpx;
  z-index: 30;
  width: 116rpx;
  height: 116rpx;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--fab-bg);
  border: var(--fab-border);
  box-shadow: var(--fab-shadow);
  backdrop-filter: blur(8rpx);
}

/* ---- 分类明细弹层（统一公共 bottom-sheet，遮罩/面板/标题由组件提供） ---- */
.cat-list {
  padding: 0 32rpx;
}
.cat-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}
.cat-item__date {
  width: 120rpx;
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--text-secondary);
}
.cat-item__main {
  flex: 1;
  min-width: 0;
  margin: 0 16rpx;
}
.cat-item__note {
  font-size: 24rpx;
  color: var(--text-faint);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.cat-item__amount {
  flex-shrink: 0;
  font-size: 26rpx;
  font-weight: 600;
}
.cat-empty {
  padding: 60rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: var(--text-faint);
}

/* ================= 预算日详情 ================= */
.dayd {
  padding: 8rpx 8rpx 24rpx;
}
.dayd__rows {
  margin-bottom: 8rpx;
}
.dayd__notice {
  padding: 18rpx 12rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #eef1f8;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}
.dayd__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 12rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}
.dayd__label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.6);
}
.dayd__val {
  font-size: 28rpx;
  font-weight: 600;
  color: #eef1f8;
  font-variant-numeric: tabular-nums;
}
.dayd__cathead {
  margin-top: 18rpx;
  padding: 0 12rpx 10rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.45);
}
.dayd__cat {
  display: flex;
  align-items: center;
  padding: 12rpx 12rpx;
}
.dayd__cat-emoji {
  font-size: 30rpx;
  margin-right: 14rpx;
}
.dayd__cat-name {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: #e8ecf5;
}
.dayd__cat-cents {
  font-size: 26rpx;
  font-weight: 600;
  color: #eef1f8;
  font-variant-numeric: tabular-nums;
}
.dayd__bill {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 12rpx;
}
.dayd__bill-name {
  flex: 1;
  min-width: 0;
  font-size: 25rpx;
  color: rgba(255, 255, 255, 0.7);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.dayd__bill-amount {
  font-size: 25rpx;
  font-weight: 600;
  color: #eef1f8;
  font-variant-numeric: tabular-nums;
}
.dayd__empty {
  padding: 30rpx 0 10rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--text-faint);
}

/* ===== G6 数据保护模式 ===== */
.safe-mode {
  width: 100%;
  box-sizing: border-box;
}
.safe-mode__inner {
  padding: 130rpx 48rpx 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.safe-mode__icon {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 170, 90, 0.55);
  background: rgba(255, 150, 80, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 36rpx;
}
.safe-mode__icon-text {
  font-size: 64rpx;
  font-weight: 700;
  color: #ffb454;
  line-height: 1;
}
.safe-mode__title {
  width: 100%;
  box-sizing: border-box;
  font-size: 38rpx;
  font-weight: 700;
  color: #f2f4fa;
  text-align: center;
  margin-bottom: 20rpx;
}
.safe-mode__desc {
  width: 100%;
  box-sizing: border-box;
  font-size: 26rpx;
  line-height: 1.7;
  color: rgba(255, 255, 255, 0.6);
  text-align: center;
  word-break: break-word;
  margin-bottom: 40rpx;
}
.safe-mode__items {
  width: 100%;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 24rpx;
  padding: 8rpx 28rpx;
  margin-bottom: 40rpx;
}
.safe-mode__item {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  padding: 22rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}
.safe-mode__item:last-child {
  border-bottom: none;
}
.safe-mode__item-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.safe-mode__item-label {
  font-size: 27rpx;
  color: rgba(255, 255, 255, 0.82);
}
.safe-mode__item-status {
  font-size: 23rpx;
  color: #ffb454;
  font-variant-numeric: tabular-nums;
}
.safe-mode__item-detail {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: rgba(255, 255, 255, 0.62);
  word-break: break-all;
  white-space: normal;
}
.safe-mode__btn {
  width: 100%;
  box-sizing: border-box;
  height: 92rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 29rpx;
  color: rgba(255, 255, 255, 0.88);
  background: rgba(255, 255, 255, 0.07);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  margin-bottom: 22rpx;
}
.safe-mode__btn--primary {
  background: linear-gradient(135deg, #7c86ff 0%, #5b67f0 100%);
  border: none;
  color: #fff;
  font-weight: 600;
}
