.shell {
  position: relative;
  width: 100%;
  overflow: hidden;
}

/* ---- 背景 ---- */
.shell-bg {
  position: absolute;
  inset: 0;
  z-index: 0;
  background: linear-gradient(180deg, #0c0e1a 0%, #05060a 100%);
}
.shell-bg__glow {
  position: absolute;
  border-radius: 50%;
}
.shell-bg__glow--1 {
  width: 460px;
  height: 460px;
  top: -140px;
  left: -120px;
  background: radial-gradient(circle, var(--glow-1), transparent 70%);
}
.shell-bg__glow--2 {
  width: 380px;
  height: 380px;
  bottom: -120px;
  right: -120px;
  background: radial-gradient(circle, var(--glow-2), transparent 70%);
}

/* ---- 自定义 Header ---- */
.header {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 20;
  box-sizing: border-box;
}
.header__bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
}
.header__title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
}
.header__actions {
  display: flex;
  align-items: center;
  flex: 1;
  justify-content: flex-end;
  margin-left: 20rpx;
  min-width: 0;
}
.header__search {
  flex: 1;
  height: 56rpx;
  padding: 0 20rpx;
  margin-right: 8rpx;
  max-width: 300rpx;
}
.header__search-icon {
  font-size: 22rpx;
  margin-right: 8rpx;
}
.header__search-text {
  font-size: 24rpx;
}
.header__setting {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.header__setting-icon {
  font-size: 34rpx;
}

/* ---- 顶部 Tabs ---- */
.tabs {
  position: absolute;
  left: 0;
  right: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: center;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}
.tabs__item {
  flex: 1;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: var(--text-secondary);
  position: relative;
}
.tabs__item.active {
  color: var(--text-primary);
  font-weight: 600;
}
.tabs__item.active::after {
  content: '';
  position: absolute;
  bottom: 4rpx;
  width: 44rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: var(--primary);
}

/* ---- Swiper ---- */
.swiper {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
}

/* ---- 玻璃 FAB ---- */
.fab-wrap {
  position: absolute;
  right: 36rpx;
  z-index: 30;
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, rgba(124, 134, 255, 0.45), rgba(124, 134, 255, 0.16));
  border: 1rpx solid rgba(255, 255, 255, 0.25);
  box-shadow: 0 12rpx 36rpx rgba(124, 134, 255, 0.42);
}
.fab-icon {
  font-size: 56rpx;
  color: #ffffff;
  font-weight: 300;
}
