.shell {
  position: relative;
  width: 100%;
  overflow: hidden;
}

/* ---- 背景 ---- */
.shell-bg {
  position: absolute;
  inset: 0;
  z-index: 0;
  background: linear-gradient(180deg, #0c0e1a 0%, #05060a 100%);
}
.shell-bg__glow {
  position: absolute;
  border-radius: 50%;
}
.shell-bg__glow--1 {
  width: 460px;
  height: 460px;
  top: -140px;
  left: -120px;
  background: radial-gradient(circle, var(--glow-1), transparent 70%);
}
.shell-bg__glow--2 {
  width: 380px;
  height: 380px;
  bottom: -120px;
  right: -120px;
  background: radial-gradient(circle, var(--glow-2), transparent 70%);
}

/* ---- 自定义 Header ---- */
.header {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 20;
  box-sizing: border-box;
}
.header__bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
}
.header__title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
}
.header__actions {
  display: flex;
  align-items: center;
  flex: 1;
  justify-content: flex-end;
  margin-left: 20rpx;
  min-width: 0;
}
.header__search {
  flex: 1;
  height: 56rpx;
  padding: 0 20rpx;
  margin-right: 8rpx;
  max-width: 300rpx;
}
.header__search-icon {
  margin-right: 8rpx;
  display: flex;
  align-items: center;
}
.header__search-text {
  font-size: 24rpx;
}
.header__setting {
  width: 56rpx;
  height: 56rpx;
  margin-left: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ---- 顶部 Tabs ---- */
.tabs {
  position: absolute;
  left: 0;
  right: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: center;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}
.tabs__item {
  flex: 1;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.42);
  position: relative;
  transition: color 0.18s ease;
}
.tabs__item.active {
  color: #f2f3ff;
  font-weight: 600;
}
.tabs__item.active::after {
  content: '';
  position: absolute;
  bottom: 5rpx;
  width: 44rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: linear-gradient(90deg, var(--primary), var(--primary-deep));
  box-shadow: 0 0 10rpx var(--primary-glow);
}

/* ---- Swiper ---- */
.swiper {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
}

/* ---- 玻璃 FAB（大圆角方形，非圆形浮球；柔和紫光） ---- */
.fab-wrap {
  position: absolute;
  right: 36rpx;
  z-index: 30;
  width: 116rpx;
  height: 116rpx;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--fab-bg);
  border: var(--fab-border);
  box-shadow: var(--fab-shadow);
  backdrop-filter: blur(8rpx);
}
.fab-icon {
  font-size: 60rpx;
  color: #ffffff;
  font-weight: 300;
  line-height: 1;
}

/* ---- 分类明细弹层（页面级 fixed，相对视口） ---- */
.cat-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  background: rgba(0, 0, 0, 0);
  pointer-events: none;
}
.cat-mask--show {
  background: rgba(0, 0, 0, 0.55);
  pointer-events: auto;
}
.cat-sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  max-height: 70vh;
  border-radius: 36rpx 36rpx 0 0;
  background: linear-gradient(180deg, rgba(26, 30, 48, 0.98), rgba(12, 14, 24, 0.98));
  transform: translateY(100%);
  transition: transform 0.22s ease-out;
  display: flex;
  flex-direction: column;
}
.cat-mask--show .cat-sheet {
  transform: translateY(0);
}
.cat-sheet__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
}
.cat-sheet__title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}
.cat-sheet__close {
  width: 56rpx;
  height: 56rpx;
  line-height: 52rpx;
  text-align: center;
  font-size: 44rpx;
  color: var(--text-secondary);
}
.cat-sheet__scroll {
  /* scroll-view 需要明确高度才能渲染/滚动；高度约为屏幕下半部 */
  height: 48vh;
  padding: 0 32rpx;
  box-sizing: border-box;
}
.cat-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}
.cat-item__date {
  width: 120rpx;
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--text-secondary);
}
.cat-item__main {
  flex: 1;
  min-width: 0;
  margin: 0 16rpx;
}
.cat-item__note {
  font-size: 24rpx;
  color: var(--text-faint);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.cat-item__amount {
  flex-shrink: 0;
  font-size: 26rpx;
  font-weight: 600;
}
.cat-empty {
  padding: 60rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: var(--text-faint);
}
