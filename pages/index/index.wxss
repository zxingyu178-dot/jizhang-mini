/* pages/index/index.wxss */
.summary-card {
  background: linear-gradient(135deg, #07c160, #06ad56);
  color: #ffffff;
  margin-bottom: 24rpx;
}

.month-label {
  font-size: 24rpx;
  opacity: 0.9;
}

.balance {
  font-size: 60rpx;
  font-weight: 600;
  margin: 12rpx 0 24rpx;
}

.summary-row {
  display: flex;
}

.summary-item {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.summary-divider {
  width: 1rpx;
  background: rgba(255, 255, 255, 0.3);
  margin: 0 20rpx;
}

.summary-label {
  font-size: 24rpx;
  opacity: 0.9;
}

.summary-value {
  font-size: 34rpx;
  margin-top: 8rpx;
  font-weight: 500;
}

.day-group {
  margin-bottom: 20rpx;
}

.day-header {
  display: flex;
  justify-content: space-between;
  padding: 8rpx 12rpx;
  color: #8a8f99;
  font-size: 24rpx;
}

.record-list {
  padding: 0 28rpx;
}

.record-item {
  display: flex;
  align-items: center;
  padding: 26rpx 0;
  border-bottom: 1rpx solid #f0f1f3;
}

.record-item:last-child {
  border-bottom: none;
}

.record-emoji {
  font-size: 44rpx;
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  background: #f5f6f8;
  border-radius: 50%;
  margin-right: 20rpx;
}

.record-main {
  flex: 1;
  overflow: hidden;
}

.record-category {
  font-size: 30rpx;
}

.record-note {
  margin-top: 6rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.record-amount {
  font-size: 32rpx;
  font-weight: 500;
}

.fab-wrap {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 40rpx;
  padding: 0 48rpx;
}

.fab {
  width: 100%;
}

.empty-btn {
  width: 360rpx;
  margin-top: 40rpx;
}
