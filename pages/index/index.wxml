<view class="container">
  <!-- 本月汇总卡片 -->
  <view class="card summary-card">
    <view class="month-label">{{month}} 本月结余</view>
    <view class="balance">¥ {{balance}}</view>
    <view class="summary-row">
      <view class="summary-item">
        <view class="summary-label">收入</view>
        <view class="summary-value">{{totalIncome}}</view>
      </view>
      <view class="summary-divider"></view>
      <view class="summary-item">
        <view class="summary-label">支出</view>
        <view class="summary-value">{{totalExpense}}</view>
      </view>
    </view>
  </view>

  <!-- 空态 -->
  <view class="empty" wx:if="{{isEmpty}}">
    <view class="empty-icon">📒</view>
    <view>还没有记录，点击下方按钮记一笔</view>
    <button class="btn-primary empty-btn" bindtap="goAdd">记一笔</button>
  </view>

  <!-- 按日期分组的账单 -->
  <block wx:else>
    <view class="day-group" wx:for="{{groups}}" wx:key="date">
      <view class="day-header">
        <text class="day-date">{{item.friendlyDate}}</text>
        <text class="day-total">
          <text class="money-expense" wx:if="{{item.showExpense}}">支 {{item.expenseText}} </text>
          <text class="money-income" wx:if="{{item.showIncome}}">收 {{item.incomeText}}</text>
        </text>
      </view>
      <view class="card record-list">
        <view
          class="record-item"
          wx:for="{{item.records}}"
          wx:for-item="rec"
          wx:key="id"
          data-id="{{rec.id}}"
          bindtap="onRecordTap"
        >
          <view class="record-emoji">{{rec.emoji}}</view>
          <view class="record-main">
            <view class="record-category">{{rec.categoryLabel}}</view>
            <view class="record-note text-secondary" wx:if="{{rec.note}}">{{rec.note}}</view>
          </view>
          <view class="record-amount {{rec.type === 'income' ? 'money-income' : 'money-expense'}}">
            {{rec.amountText}}
          </view>
        </view>
      </view>
    </view>
  </block>

  <!-- 底部记账按钮 -->
  <view class="fab-wrap" wx:if="{{!isEmpty}}">
    <button class="btn-primary fab" bindtap="goAdd">＋ 记一笔</button>
  </view>
</view>
