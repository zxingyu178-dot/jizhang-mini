/* pages/stats/stats.wxss */
.type-switch {
  display: flex;
  background: #ffffff;
  border-radius: 48rpx;
  padding: 6rpx;
  margin-bottom: 24rpx;
}

.type-item {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 48rpx;
  font-size: 30rpx;
  color: #8a8f99;
}

.type-item.active.expense {
  background: #fa5151;
  color: #ffffff;
}

.type-item.active.income {
  background: #07c160;
  color: #ffffff;
}

.total-card {
  text-align: center;
  margin-bottom: 24rpx;
}

.total-label {
  color: #8a8f99;
  font-size: 24rpx;
}

.total-amount {
  font-size: 56rpx;
  font-weight: 600;
  margin-top: 12rpx;
}

.stat-item {
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f0f1f3;
}

.stat-item:last-child {
  border-bottom: none;
}

.stat-head {
  display: flex;
  justify-content: space-between;
  margin-bottom: 14rpx;
  font-size: 28rpx;
}

.stat-amount {
  color: #5a6068;
  font-size: 26rpx;
}

.bar {
  height: 16rpx;
  background: #f0f1f3;
  border-radius: 16rpx;
  overflow: hidden;
}

.bar-inner {
  height: 100%;
  border-radius: 16rpx;
  transition: width 0.3s ease;
}

.bar-inner.expense {
  background: linear-gradient(90deg, #ff7a7a, #fa5151);
}

.bar-inner.income {
  background: linear-gradient(90deg, #39d98a, #07c160);
}
