<view class="container">
  <!-- 收支切换 -->
  <view class="type-switch">
    <view
      wx:for="{{types}}"
      wx:key="value"
      class="type-item {{type === item.value ? 'active ' + item.value : ''}}"
      data-type="{{item.value}}"
      bindtap="switchType"
    >{{item.label}}</view>
  </view>

  <!-- 总额 -->
  <view class="card total-card">
    <view class="total-label">累计{{type === 'expense' ? '支出' : '收入'}}</view>
    <view class="total-amount {{type === 'expense' ? 'money-expense' : 'money-income'}}">
      ¥ {{totalText}}
    </view>
  </view>

  <!-- 空态 -->
  <view class="empty" wx:if="{{isEmpty}}">
    <view class="empty-icon">📊</view>
    <view>暂无{{type === 'expense' ? '支出' : '收入'}}数据</view>
  </view>

  <!-- 分类占比 -->
  <view class="card" wx:else>
    <view class="stat-item" wx:for="{{items}}" wx:key="value">
      <view class="stat-head">
        <view class="stat-name">{{item.emoji}} {{item.label}}</view>
        <view class="stat-amount">¥{{item.amountText}} · {{item.percentText}}%</view>
      </view>
      <view class="bar">
        <view class="bar-inner {{type}}" style="width: {{item.percent}}%"></view>
      </view>
    </view>
  </view>
</view>
