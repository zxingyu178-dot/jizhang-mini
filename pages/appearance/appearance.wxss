/* pages/appearance/appearance.wxss —— 外观页（深色/浅色 token 自动适配） */
.ap-page {
  position: relative;
  width: 100%;
  background: var(--bg);
}
.ap-bg {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: var(--page-bg);
}
.ap-bg__glow {
  position: absolute;
  top: -120rpx;
  left: -100rpx;
  width: 500rpx;
  height: 500rpx;
  border-radius: 50%;
  background: radial-gradient(circle, var(--glow-1) 0%, transparent 70%);
}

/* 滚动区 */
.ap-scroll {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
}

.sec-label {
  font-size: 24rpx;
  color: var(--text-faint);
  padding: 28rpx 32rpx 12rpx;
}
.sec {
  margin: 0 28rpx 8rpx;
  padding: 0 24rpx;
}
.row {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--divider);
}
.row--last {
  border-bottom: none;
}
.row__main {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.row__label {
  font-size: 28rpx;
  color: var(--text-primary);
}
.row__sub {
  font-size: 22rpx;
  color: var(--text-faint);
  margin-top: 6rpx;
}

/* ---- 主题色四选一（v1.4.5） ---- */
.accent-grid {
  display: flex;
  align-items: flex-start;
  padding: 24rpx 0 28rpx;
}
.accent-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.accent-dot {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  /* 圆环描边：浅色底的色块（如琥珀）不靠描边会和白玻璃糊在一起 */
  border: 2rpx solid var(--card-border);
}
.accent-item__label {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}
.accent-item__label--on {
  color: var(--text-primary);
  font-weight: 600;
}
