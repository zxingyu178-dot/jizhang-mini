.settings-page {
  position: relative;
  width: 100%;
  background: var(--bg);
}
.settings-bg {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: linear-gradient(180deg, #0a0f1e 0%, #05060a 100%);
}
.settings-bg__glow {
  position: absolute;
  top: -120rpx;
  left: -100rpx;
  width: 500rpx;
  height: 500rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(124, 134, 255, 0.18) 0%, transparent 70%);
}

/* Header 由全局 <page-header> 组件统一提供 */

/* 滚动区 */
.set-scroll {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
}

.sec-label {
  font-size: 24rpx;
  color: var(--text-faint);
  padding: 28rpx 32rpx 12rpx;
}

.sec {
  margin: 0 28rpx 8rpx;
  padding: 0 24rpx;
}
/* 导入说明卡 */
.sec-note {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
}
.note-line {
  font-size: 23rpx;
  line-height: 1.7;
  color: var(--text-secondary);
  padding-bottom: 10rpx;
}
.note-line--last {
  padding-bottom: 0;
}
.row {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}
.row--last {
  border-bottom: none;
}
.row__icon {
  font-size: 36rpx;
  margin-right: 20rpx;
  width: 48rpx;
  text-align: center;
}
.row__label {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-primary);
}
.row__main {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.row__sub {
  font-size: 22rpx;
  color: var(--text-faint);
  margin-top: 6rpx;
}
.row__val {
  font-size: 28rpx;
  color: var(--text-secondary);
}
.row__right {
  display: flex;
  align-items: center;
  gap: 6rpx;
}
.row__hint {
  font-size: 26rpx;
  color: var(--text-secondary);
}
.row__arrow {
  font-size: 36rpx;
  color: var(--text-faint);
}

.glass-empty.mini {
  margin: 0 28rpx;
  padding: 32rpx;
}
.glass-empty.mini .tip {
  font-size: 26rpx;
}

.privacy {
  display: flex;
  align-items: flex-start;
  padding: 32rpx 40rpx 60rpx;
}
.privacy__icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}
.privacy__text {
  flex: 1;
  font-size: 24rpx;
  color: var(--text-faint);
  line-height: 1.6;
}
