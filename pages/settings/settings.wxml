<view class="settings-page {{themeClass}}" style="height:{{windowHeight}}px;">
  <view class="settings-bg">
    <view class="settings-bg__glow"></view>
  </view>

  <!-- 统一二级页 Header -->
  <page-header title="设置"></page-header>

  <scroll-view scroll-y class="set-scroll" style="top:{{headerHeight}}px;" enhanced show-scrollbar="{{false}}">
    <!-- 记账 -->
    <view class="sec-label">记账</view>
    <view class="glass-card sec">
      <view class="row" bindtap="onCategoryManage">
        <text class="row__label">分类管理</text>
        <dv-icon name="chevronRight" size="20" tone="faint"></dv-icon>
      </view>
      <view class="row row--last" bindtap="onRecurring">
        <text class="row__label">周期记账</text>
        <dv-icon name="chevronRight" size="20" tone="faint"></dv-icon>
      </view>
    </view>

    <!-- 预算 -->
    <view class="sec-label">预算</view>
    <view class="glass-card sec">
      <view class="row" bindtap="onBudgetSettings">
        <text class="row__label">每日预算</text>
        <view class="row__right">
          <text class="row__hint">{{budgetHint}}</text>
          <dv-icon name="chevronRight" size="20" tone="faint"></dv-icon>
        </view>
      </view>
    </view>

    <!-- 外观 -->
    <view class="sec-label">外观</view>
    <view class="glass-card sec">
      <view class="row row--last" bindtap="onAppearance">
        <text class="row__label">主题</text>
        <view class="row__right">
          <text class="row__hint">{{themeHint}}</text>
          <dv-icon name="chevronRight" size="20" tone="faint"></dv-icon>
        </view>
      </view>
    </view>

    <!-- 数据 -->
    <view class="sec-label">数据</view>
    <view class="glass-card sec">
      <view class="row" bindtap="onImport">
        <text class="row__label">数据导入</text>
        <dv-icon name="chevronRight" size="20" tone="faint"></dv-icon>
      </view>
      <view class="row row--last" bindtap="onBackupRestore">
        <text class="row__label">备份与恢复</text>
        <dv-icon name="chevronRight" size="20" tone="faint"></dv-icon>
      </view>
    </view>

    <!-- 关于 -->
    <view class="sec-label">关于</view>
    <view class="glass-card sec">
      <view class="row">
        <text class="row__label">版本</text>
        <text class="row__val">{{version}}</text>
      </view>
      <view class="row" bindtap="onReleaseNotes">
        <text class="row__label">更新日志</text>
        <dv-icon name="chevronRight" size="20" tone="faint"></dv-icon>
      </view>
      <view class="row row--last" bindtap="onPrivacy">
        <text class="row__label">数据与隐私</text>
        <dv-icon name="chevronRight" size="20" tone="faint"></dv-icon>
      </view>
    </view>
  </scroll-view>
</view>
