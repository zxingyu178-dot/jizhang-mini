{
  "pages": [
    "pages/main/main",
    "pages/search/search",
    "pages/settings/settings",
    "pages/backup-restore/backup-restore",
    "pages/data-privacy/data-privacy",
    "pages/budget-settings/budget-settings",
    "pages/daily-value-detail/detail"
  ],
  "window": {
    "navigationStyle": "custom",
    "navigationBarTitleText": "每日的价值",
    "navigationBarBackgroundColor": "#05060a",
    "navigationBarTextStyle": "white",
    "backgroundColor": "#05060a",
    "backgroundTextStyle": "light"
  },
  "renderer": "skyline",
  "rendererOptions": {
    "skyline": {
      "disableABTest": true,
      "sdkVersionBegin": "3.0.0",
      "sdkVersionEnd": "15.255.255",
      "defaultDisplayBlock": true,
      "defaultContentBox": true
    }
  },
  "subpackages": [
    {
      "root": "packages/importer",
      "name": "importer",
      "pages": [
        "pages/import/import",
        "pages/preview/preview",
        "pages/result/result"
      ]
    }
  ],
  "preloadRule": {
    "pages/settings/settings": {
      "network": "all",
      "packages": ["importer"]
    }
  },
  "componentFramework": "glass-easel",
  "style": "v2",
  "sitemapLocation": "sitemap.json",
  "lazyCodeLoading": "requiredComponents"
}
