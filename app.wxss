/* ============================================================
   随时随地大小记 · 全局设计 token（v0.9.0 双主题 / Dark & Light）
   主题：themeClass 由 utils/theme.js 注入到页面根容器（.theme-dark/.theme-light）。
   深色紫黑毛玻璃为 Golden Reference，沿用既有视觉；浅色为浅灰紫白玻璃。
   玻璃卡以「半透明 + 渐变 + 边缘高光 + 轻阴影 + 背景透出」实现，不依赖实时
   backdrop-filter，WebView / Skyline 双端视觉稳定。
   结构：
     page                 布局公共值（圆角/间距/字体）+ 深色 fallback
     page, .theme-dark    深色 token（page 作 fallback，漏 themeClass 也回到深色）
     .theme-light         浅色 token
   原生状态栏/窗口背景由 app.json(darkmode) + theme.json 跟随系统。
   ============================================================ */

/* ============================================================
   一、布局公共值（不随主题变化）
   ============================================================ */
page {
  /* 圆角 */
  --r-sm: 16rpx;
  --r-md: 24rpx;
  --r-lg: 32rpx;
  --r-xl: 40rpx;
  --r-pill: 999rpx;

  /* 布局间距：页面外边距 / 卡片内边距 */
  --space-page: 32rpx;
  --space-card: 28rpx;

  font-size: 28rpx;
  line-height: 1.5;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue",
    "PingFang SC", "Microsoft YaHei", sans-serif;
  -webkit-font-smoothing: antialiased;
}

/* ============================================================
   二、深色主题（page fallback + .theme-dark 显式）
   紫黑毛玻璃 / Dark Glass —— v0.8.1 已确认视觉，保持不改。
   ============================================================ */
page, .theme-dark {
  /* ---- 底色 / 背景 ---- */
  --bg: #05060a;
  --bg-soft: #0b0d16;
  --page-bg: #05060a;
  --page-bg-soft: #0b0d16;

  /* ---- 紫色柔光（无壁纸时的背景光晕） ---- */
  --glow-1: rgba(124, 134, 255, 0.34);
  --glow-2: rgba(91, 103, 240, 0.22);

  /* ---- 玻璃 Surface ---- */
  --surface: rgba(255, 255, 255, 0.05);
  --surface-strong: rgba(255, 255, 255, 0.07);
  --surface-soft: rgba(255, 255, 255, 0.035);
  --card-bg: linear-gradient(135deg, rgba(255, 255, 255, 0.09) 0%, rgba(255, 255, 255, 0.03) 100%);
  --card-border: rgba(255, 255, 255, 0.10);
  --card-border-hi: rgba(255, 255, 255, 0.18);
  --card-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.28);

  /* 语义化玻璃别名（Hero / FAB / 软底统一复用） */
  --glass-card-bg: var(--card-bg);
  --glass-soft-bg: var(--surface-soft);
  --glass-border: var(--card-border);
  --glass-highlight: var(--card-border-hi);
  --glass-shadow: var(--card-shadow);
  --glass-glow: var(--primary-glow);

  /* 记账 Hero：透明深色玻璃 + 紫色只做光，不做紫色实体卡 */
  --hero-bg: linear-gradient(135deg, rgba(124, 134, 255, 0.16) 0%, rgba(255, 255, 255, 0.04) 46%, rgba(91, 103, 240, 0.10) 100%);
  --hero-border: 1rpx solid rgba(255, 255, 255, 0.14);
  --hero-shadow: 0 14rpx 44rpx rgba(8, 10, 24, 0.46), inset 0 1rpx 0 rgba(255, 255, 255, 0.14);
  --hero-arrow-bg: rgba(255, 255, 255, 0.14);
  --hero-arrow-active: rgba(255, 255, 0.26);
  --hero-glow: rgba(124, 134, 255, 0.22);

  /* FAB：大圆角方形玻璃（柔和紫光，不做霓虹球） */
  --fab-bg: linear-gradient(150deg, rgba(124, 134, 255, 0.34) 0%, rgba(124, 134, 255, 0.10) 100%);
  --fab-border: 1rpx solid rgba(255, 255, 255, 0.22);
  --fab-shadow: 0 10rpx 28rpx rgba(124, 134, 255, 0.28), inset 0 1rpx 0 rgba(255, 255, 255, 0.18);

  /* ---- 玻璃胶囊（搜索） ---- */
  --pill-bg: rgba(255, 255, 255, 0.08);
  --pill-border: rgba(255, 255, 255, 0.14);

  /* ---- 文字 ---- */
  --text-primary: #eef1f8;
  --text-secondary: rgba(255, 255, 255, 0.62);
  --text-faint: rgba(255, 255, 255, 0.40);
  --text-title: #f2f4fb;
  --text-body: rgba(255, 255, 255, 0.78);
  --text-caption: rgba(255, 255, 255, 0.50);
  --text-inverse: #0b0d16;

  /* ---- 品牌主色（亮紫） ---- */
  --primary: #7c86ff;
  --primary-deep: #5b67f0;
  --primary-glow: rgba(124, 134, 255, 0.32);
  --primary-tint: rgba(124, 134, 255, 0.16);
  --on-primary: #ffffff;

  /* ---- 业务语义（固定规则：支出=绿、收入=红，不随主题反转） ---- */
  --expense: #3ddc8f;
  --expense-soft: rgba(61, 220, 143, 0.16);
  --income: #ff6b6b;
  --income-soft: rgba(255, 107, 107, 0.16);

  /* ---- 预算语义（与业务收支色解耦：盈余=绿、超支=红） ---- */
  --budget-surplus: #38c896;
  --budget-over: #ef606b;
  --budget-surplus-soft: rgba(56, 200, 150, 0.16);
  --budget-over-soft: rgba(239, 96, 107, 0.16);
  /* 预算日历单元格状态色（深：半透明状态底 + 亮色数字） */
  --cal-surplus-lv1-bg: rgba(56, 200, 150, 0.16);
  --cal-surplus-lv1-num: #5fd6ab;
  --cal-surplus-lv2-bg: rgba(56, 200, 150, 0.30);
  --cal-surplus-lv2-num: #8fe7c6;
  --cal-over-lv1-bg: rgba(239, 96, 107, 0.16);
  --cal-over-lv1-num: #f5838b;
  --cal-over-lv2-bg: rgba(239, 96, 107, 0.32);
  --cal-over-lv2-num: #f89aa0;

  /* ---- 危险 / 警告 ---- */
  --danger: #ef606b;
  --danger-soft: rgba(239, 96, 107, 0.16);
  --warning: #f0b35b;
  --warning-soft: rgba(240, 179, 91, 0.16);

  /* ---- 弹层（深玻璃实底，不透底） ---- */
  --overlay-bg: rgba(13, 13, 16, 0.88);
  --overlay-border: rgba(255, 255, 255, 0.08);

  /* ---- 玻璃层级：页面底 / 卡片 / 底部弹层 / 输入框 ---- */
  --glass-page: var(--bg);
  --glass-card: var(--card-bg);
  --glass-sheet: linear-gradient(180deg, rgba(124, 134, 255, 0.16) 0%, rgba(124, 134, 255, 0) 240rpx), linear-gradient(180deg, rgba(26, 30, 54, 0.97) 0%, rgba(14, 18, 36, 0.98) 100%);
  --glass-input: rgba(255, 255, 255, 0.06);
  --glass-input-border: rgba(255, 255, 255, 0.12);
  --sheet-mask: rgba(0, 0, 0, 0.42);

  /* ---- 分隔线 ---- */
  --divider: rgba(255, 255, 255, 0.08);

  /* ---- 选中 / 悬浮态 ---- */
  --selected-bg: rgba(124, 134, 255, 0.22);
  --hover-bg: rgba(255, 255, 255, 0.06);
  --switch-off-bg: rgba(255, 255, 255, 0.18);

  /* ---- 图标语义色（base64 SVG 无法直接吃 CSS var，由 dv-icon 按 tone 映射） ---- */
  --icon-primary: rgba(255, 255, 255, 0.86);
  --icon-secondary: rgba(255, 255, 255, 0.62);
  --icon-faint: rgba(255, 255, 255, 0.40);
  --icon-inverse: #0b0d16;
  --icon-brand: #7c86ff;
  --icon-danger: #ef606b;

  /* ---- 按钮：主操作 / 危险 / 禁用 ---- */
  --button-primary: linear-gradient(135deg, #7c86ff 0%, #5b67f0 100%);
  --button-primary-text: #ffffff;
  --button-primary-shadow: 0 6rpx 18rpx rgba(91, 103, 240, 0.22);
  --button-danger: linear-gradient(135deg, #ef606b 0%, #d94a55 100%);
  --button-danger-text: #ffffff;
  --button-disabled: rgba(255, 255, 255, 0.08);
  --button-disabled-text: rgba(255, 255, 255, 0.34);

  /* 页面背景渐变（深，精确还原 Golden Reference） */
  --bg-gradient: linear-gradient(180deg, #0c0e1a 0%, #05060a 100%);

  background-color: var(--bg);
  color: var(--text-primary);
}

/* ============================================================
   三、浅色主题（.theme-light）
   浅灰蓝 + 淡紫白玻璃（非纯白），与深色是同一产品。
   业务支出仍绿、收入仍红、预算盈余绿/超支红（仅加深以保证白底对比，不反转）。
   ============================================================ */
.theme-light {
  /* ---- 底色 / 背景 ---- */
  --bg: #f3f4fa;
  --bg-soft: #e9ecf6;
  --page-bg: #f3f4fa;
  --page-bg-soft: #e9ecf6;

  /* ---- 紫色柔光（更淡） ---- */
  --glow-1: rgba(124, 134, 255, 0.20);
  --glow-2: rgba(110, 120, 245, 0.12);

  /* ---- 玻璃 Surface（白色玻璃） ---- */
  --surface: rgba(255, 255, 255, 0.60);
  --surface-strong: rgba(255, 255, 255, 0.80);
  --surface-soft: rgba(255, 255, 255, 0.45);
  --card-bg: linear-gradient(135deg, rgba(255, 255, 255, 0.88) 0%, rgba(255, 255, 255, 0.62) 100%);
  --card-border: rgba(80, 90, 130, 0.12);
  --card-border-hi: rgba(124, 134, 255, 0.24);
  --card-shadow: 0 8rpx 32rpx rgba(60, 70, 110, 0.12);

  /* 语义化玻璃别名 */
  --glass-card-bg: var(--card-bg);
  --glass-soft-bg: var(--surface-soft);
  --glass-border: var(--card-border);
  --glass-highlight: var(--card-border-hi);
  --glass-shadow: var(--card-shadow);
  --glass-glow: var(--primary-glow);

  /* Hero：极浅紫蓝渐变 + 白色高光 + 淡紫边框（信息结构不动） */
  --hero-bg: linear-gradient(135deg, rgba(124, 134, 255, 0.14) 0%, rgba(255, 255, 255, 0.72) 46%, rgba(110, 120, 245, 0.10) 100%);
  --hero-border: 1rpx solid rgba(124, 134, 255, 0.18);
  --hero-shadow: 0 14rpx 44rpx rgba(80, 90, 130, 0.12), inset 0 1rpx 0 rgba(255, 255, 255, 0.85);
  --hero-arrow-bg: rgba(124, 134, 255, 0.16);
  --hero-arrow-active: rgba(124, 134, 255, 0.30);
  --hero-glow: rgba(124, 134, 255, 0.12);

  /* FAB：浅底下用饱满紫，保证醒目 */
  --fab-bg: linear-gradient(150deg, rgba(124, 134, 255, 0.95) 0%, rgba(110, 120, 245, 0.82) 100%);
  --fab-border: 1rpx solid rgba(255, 255, 255, 0.60);
  --fab-shadow: 0 10rpx 28rpx rgba(110, 120, 245, 0.38);

  /* ---- 玻璃胶囊 ---- */
  --pill-bg: rgba(255, 255, 255, 0.72);
  --pill-border: rgba(80, 90, 130, 0.12);

  /* ---- 文字（深蓝黑） ---- */
  --text-primary: #202334;
  --text-secondary: rgba(32, 35, 52, 0.62);
  --text-faint: rgba(32, 35, 52, 0.40);
  --text-title: #1a1d2e;
  --text-body: rgba(32, 35, 52, 0.80);
  --text-caption: rgba(32, 35, 52, 0.50);
  --text-inverse: #ffffff;

  /* ---- 品牌主色（略加深保证白底对比） ---- */
  --primary: #6e78f5;
  --primary-deep: #5660e0;
  --primary-glow: rgba(110, 120, 245, 0.28);
  --primary-tint: rgba(110, 120, 245, 0.14);
  --on-primary: #ffffff;

  /* ---- 业务语义（同色系加深，方向不变：支出绿 / 收入红） ---- */
  --expense: #16a36c;
  --expense-soft: rgba(22, 163, 108, 0.14);
  --income: #e0474f;
  --income-soft: rgba(224, 71, 79, 0.14);

  /* ---- 预算语义（盈余绿 / 超支红） ---- */
  --budget-surplus: #159a72;
  --budget-over: #dc4a55;
  --budget-surplus-soft: rgba(21, 154, 114, 0.14);
  --budget-over-soft: rgba(220, 74, 85, 0.14);
  /* 预算日历单元格状态色（浅：白底需加深，数字用深色同系） */
  --cal-surplus-lv1-bg: rgba(21, 154, 114, 0.12);
  --cal-surplus-lv1-num: #159a72;
  --cal-surplus-lv2-bg: rgba(21, 154, 114, 0.24);
  --cal-surplus-lv2-num: #0f7f5e;
  --cal-over-lv1-bg: rgba(220, 74, 85, 0.12);
  --cal-over-lv1-num: #dc4a55;
  --cal-over-lv2-bg: rgba(220, 74, 85, 0.24);
  --cal-over-lv2-num: #b8353f;

  /* ---- 危险 / 警告 ---- */
  --danger: #dc4a55;
  --danger-soft: rgba(220, 74, 85, 0.14);
  --warning: #cc8f2e;
  --warning-soft: rgba(204, 143, 46, 0.16);

  /* ---- 弹层（浅玻璃实底） ---- */
  --overlay-bg: rgba(223, 227, 240, 0.94);
  --overlay-border: rgba(80, 90, 130, 0.14);

  /* ---- 玻璃层级：Sheet 高不透明浅色（绝不穿字） ---- */
  --glass-page: var(--bg);
  --glass-card: var(--card-bg);
  --glass-sheet: linear-gradient(180deg, rgba(124, 134, 255, 0.10) 0%, rgba(124, 134, 255, 0) 200rpx), linear-gradient(180deg, rgba(249, 250, 254, 0.985) 0%, rgba(239, 241, 249, 0.99) 100%);
  --glass-input: rgba(255, 255, 255, 0.72);
  --glass-input-border: rgba(80, 90, 130, 0.20);
  --sheet-mask: rgba(32, 38, 66, 0.34);

  /* ---- 分隔线 ---- */
  --divider: rgba(80, 90, 130, 0.12);

  /* ---- 选中 / 悬浮态 ---- */
  --selected-bg: rgba(110, 120, 245, 0.16);
  --hover-bg: rgba(80, 90, 130, 0.08);
  --switch-off-bg: rgba(80, 90, 130, 0.24);

  /* ---- 图标语义色（深色图标，在浅底上） ---- */
  --icon-primary: rgba(25, 28, 40, 0.88);
  --icon-secondary: rgba(25, 28, 40, 0.58);
  --icon-faint: rgba(25, 28, 40, 0.38);
  --icon-inverse: #ffffff;
  --icon-brand: #6e78f5;
  --icon-danger: #dc4a55;

  /* ---- 按钮 ---- */
  --button-primary: linear-gradient(135deg, #6e78f5 0%, #5660e0 100%);
  --button-primary-text: #ffffff;
  --button-primary-shadow: 0 6rpx 18rpx rgba(86, 96, 224, 0.32);
  --button-danger: linear-gradient(135deg, #e0474f 0%, #c8363f 100%);
  --button-danger-text: #ffffff;
  --button-disabled: rgba(80, 90, 130, 0.10);
  --button-disabled-text: rgba(32, 35, 52, 0.32);

  /* 页面背景渐变（浅，浅灰紫） */
  --bg-gradient: linear-gradient(180deg, #e9ecf6 0%, #f3f4fa 100%);

  background-color: var(--bg);
  color: var(--text-primary);
}

/* ============================================================
   四、通用类（引用 token，自动适配双主题）
   ============================================================ */

/* ---- 通用玻璃卡 ---- */
.glass-card {
  background: var(--card-bg);
  border: 1rpx solid var(--card-border);
  border-radius: var(--r-lg);
  box-shadow: var(--card-shadow);
  box-sizing: border-box;
}

/* ---- 玻璃胶囊 ---- */
.glass-pill {
  display: flex;
  align-items: center;
  background: var(--pill-bg);
  border: 1rpx solid var(--pill-border);
  border-radius: var(--r-pill);
  color: var(--text-secondary);
}

/* ---- 金额 ---- */
.money-expense { color: var(--expense); }
.money-income { color: var(--income); }

/* ---- 预算盈亏（盈余绿 / 超支红，独立于业务收支色） ---- */
.budget-surplus { color: var(--budget-surplus); }
.budget-over { color: var(--budget-over); }

/* ---- 空态 ---- */
.glass-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  color: var(--text-faint);
}
.glass-empty .emoji { font-size: 72rpx; margin-bottom: 20rpx; opacity: 0.7; }
.glass-empty .tip { font-size: 26rpx; color: var(--text-secondary); }
