/* packages/importer/pages/preview/preview.wxss */
.pv-page {
  min-height: 100vh;
  padding: calc(env(safe-area-inset-top) + 20rpx) 28rpx calc(env(safe-area-inset-bottom) + 160rpx);
  box-sizing: border-box;
}

.pv-header {
  margin-bottom: 24rpx;
}
.pv-title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #f2f4ff;
}
.pv-range {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #9aa4c8;
}

.pv-restore-warn {
  padding: 28rpx;
  border-radius: 24rpx;
  background: rgba(255, 107, 107, 0.12);
  border: 1rpx solid rgba(255, 107, 107, 0.3);
  margin-bottom: 24rpx;
}
.pv-restore-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #ff8a8a;
  margin-bottom: 10rpx;
}
.pv-restore-desc {
  font-size: 25rpx;
  line-height: 1.6;
  color: #d7dbe8;
}

.pv-counts {
  padding: 12rpx 28rpx;
}
.pv-count-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}
.pv-count-row:last-child {
  border-bottom: none;
}
.pv-count-label {
  font-size: 27rpx;
  color: #b3bbd8;
}
.pv-count-value {
  font-size: 28rpx;
  font-weight: 600;
  color: #eef1ff;
}
.pv-go {
  color: #3ddc8f;
}
.pv-warn {
  color: #ffc861;
}
.pv-recurring-note {
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
  font-size: 24rpx;
  line-height: 1.5;
  color: #ffc861;
}

.pv-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 20rpx 6rpx;
}
.pv-toggle-text {
  font-size: 26rpx;
  color: #c6cce4;
}
.pv-switch {
  width: 84rpx;
  height: 46rpx;
  border-radius: 46rpx;
  background: rgba(255, 255, 255, 0.16);
  position: relative;
  transition: background 0.2s;
}
.pv-switch-on {
  background: #7c86ff;
}
.pv-switch-dot {
  position: absolute;
  top: 5rpx;
  left: 5rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #fff;
  transition: transform 0.2s;
}
.pv-switch-on .pv-switch-dot {
  transform: translateX(38rpx);
}

.pv-samples {
  margin-top: 28rpx;
}
.pv-samples-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #c6cce4;
  margin: 0 6rpx 16rpx;
}
.pv-sample-card {
  padding: 8rpx 24rpx;
}
.pv-sample-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}
.pv-sample-row:last-child {
  border-bottom: none;
}
.pv-sample-left {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
}
.pv-sample-merchant {
  font-size: 28rpx;
  color: #eef1ff;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.pv-sample-cat {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #8b94b8;
}
.pv-sample-amount {
  margin-left: 20rpx;
  font-size: 28rpx;
  font-weight: 600;
}
.pv-expense {
  color: #3ddc8f;
}
.pv-income {
  color: #ff6b6b;
}

.pv-diag {
  margin: 12rpx 8rpx 180rpx;
  text-align: center;
  font-size: 24rpx;
  color: rgba(198, 204, 228, 0.55);
  padding: 16rpx;
}

.pv-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 28rpx calc(env(safe-area-inset-bottom) + 20rpx);
  background: linear-gradient(180deg, rgba(10, 12, 24, 0), rgba(10, 12, 24, 0.9));
  box-sizing: border-box;
}
.pv-btn {
  flex: 1;
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
}
.pv-btn-ghost {
  color: #c6cce4;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.14);
}
.pv-btn-primary {
  color: #fff;
  background: linear-gradient(135deg, #7c86ff, #5b67f0);
}
