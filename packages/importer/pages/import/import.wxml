<view class="import-page {{themeClass}}" style="height:{{windowHeight}}px;">
  <view class="imp-bg">
    <view class="imp-bg__glow"></view>
  </view>

  <!-- 统一二级页 Header -->
  <page-header title="数据导入"></page-header>

  <scroll-view scroll-y class="imp-scroll" style="top:{{headerHeight}}px;" enhanced show-scrollbar="{{false}}">
    <view class="imp-intro">
      <text class="imp-intro__text">支持从 DailyValue 或微信 / 支付宝账单导入，账单只保存在本机，不会上传。</text>
    </view>

    <!-- 来源卡片 -->
    <view class="src-card glass-card" wx:for="{{sources}}" wx:key="key">
      <view class="src-card__head">
        <text class="src-card__emoji">{{item.icon}}</text>
        <view class="src-card__info">
          <text class="src-card__name">{{item.name}}</text>
          <text class="src-card__desc">{{item.desc}}</text>
        </view>
      </view>

      <view class="src-card__guide" wx:if="{{item.expanded}}">
        <view class="guide-steps">
          <text class="guide-steps__text">{{item.guide}}</text>
        </view>
        <view class="guide-tip" wx:if="{{item.iosTip}}">
          <text class="guide-tip__text">🍎 iPhone：{{item.iosTip}}</text>
        </view>
      </view>

      <view class="src-card__actions">
        <view class="btn btn--ghost" data-key="{{item.key}}" bindtap="onToggleGuide">
          <text>{{item.expanded ? '收起说明' : '查看导出方法'}}</text>
        </view>
        <view class="btn btn--primary" data-key="{{item.key}}" bindtap="onChooseFile">
          <text>从微信文件中选择</text>
        </view>
      </view>
    </view>

    <!-- 最近导入 -->
    <view class="imp-hist-label">最近导入</view>
    <view class="glass-card imp-hist" wx:if="{{history.length}}">
      <view class="imp-hist__row" wx:for="{{history}}" wx:key="id">
        <text class="imp-hist__name">{{item.name}}</text>
        <text class="imp-hist__meta">{{item.time}} · {{item.count}}笔</text>
      </view>
    </view>
    <view class="glass-card imp-hist imp-hist--empty" wx:else>
      <text class="imp-hist__empty-text">暂无导入记录</text>
    </view>

    <view class="imp-foot">
      <text class="imp-foot__text">文件请先发到微信「文件传输助手」，再在本页选择</text>
    </view>
  </scroll-view>
</view>
