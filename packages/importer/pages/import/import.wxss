.import-page {
  position: relative;
  width: 100%;
}
.imp-bg {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: var(--bg-gradient);
}
.imp-bg__glow {
  position: absolute;
  top: -120rpx;
  left: 50%;
  margin-left: -250rpx;
  width: 500rpx;
  height: 500rpx;
  border-radius: 50%;
  background: radial-gradient(circle, var(--hero-glow) 0%, transparent 70%);
}

/* Header 由全局 <page-header> 组件统一提供 */

.imp-scroll {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
}

.imp-intro {
  padding: 24rpx 36rpx 12rpx;
}
.imp-intro__text {
  font-size: 25rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

/* 来源卡片 */
.src-card {
  margin: 20rpx 28rpx;
  padding: 28rpx;
}
.src-card__head {
  display: flex;
  align-items: center;
}
.src-card__emoji {
  font-size: 52rpx;
  margin-right: 20rpx;
}
.src-card__info {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.src-card__name {
  font-size: 31rpx;
  font-weight: 600;
  color: var(--text-primary);
}
.src-card__desc {
  font-size: 23rpx;
  color: var(--text-faint);
  margin-top: 6rpx;
}

.src-card__guide {
  margin-top: 20rpx;
  padding: 20rpx;
  background: var(--surface-soft);
  border-radius: 16rpx;
}
.guide-steps__text {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.7;
}
.guide-tip {
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid var(--divider);
}
.guide-tip__text {
  font-size: 23rpx;
  color: var(--text-faint);
  line-height: 1.6;
}

.src-card__actions {
  display: flex;
  margin-top: 22rpx;
}
/* 窄屏下两个按钮等分，文字单行省略，不因长文案把卡片撑破。 */
.btn {
  flex: 1;
  min-width: 0;
  box-sizing: border-box;
  text-align: center;
  padding: 22rpx 12rpx;
  font-size: 26rpx;
  border-radius: 14rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.btn--ghost {
  color: var(--text-secondary);
  background: var(--surface);
  margin-right: 16rpx;
}
.btn--primary {
  color: var(--button-primary-text);
  background: var(--button-primary);
}

/* 最近导入 */
.imp-hist-label {
  margin: 24rpx 32rpx 12rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
}
.imp-hist {
  margin: 0 28rpx;
  padding: 4rpx 24rpx;
}
.imp-hist__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--divider);
}
.imp-hist__row:last-child {
  border-bottom: none;
}
/* 长文件名必须单行省略，右侧统计信息固定不收缩。 */
.imp-hist__name {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: var(--text-primary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.imp-hist__meta {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 24rpx;
  color: var(--text-faint);
  white-space: nowrap;
}
.imp-hist--empty {
  padding: 28rpx 24rpx;
}
.imp-hist__empty-text {
  width: 100%;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-faint);
}

.imp-foot {
  padding: 24rpx 40rpx calc(env(safe-area-inset-bottom) + 40rpx);
}
.imp-foot__text {
  font-size: 22rpx;
  color: var(--text-faint);
}
